---
import { db, Groups } from 'astro:db';
import { sortGroupsByNumber } from '../utils/plantSort';

const groupsData = sortGroupsByNumber(await db.select().from(Groups));
---

<div class="h-full flex flex-col bg-forest-deep relative overflow-hidden">
  <div id="map-container" class="relative flex-grow">
    <div id="map" class="absolute inset-0 z-10"></div>
    
    <!-- Real-time Location Button (iOS Style) -->
    <button id="recenter-map" class="absolute bottom-40 right-5 z-20 w-12 h-12 glass rounded-2xl shadow-xl border-[0.5px] border-white/10 flex items-center justify-center text-cream-warm active:scale-95 transition-all">
      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
    </button>
  </div>

  <!-- Apple Maps Style Bottom Drawer -->
  <div id="bottom-sheet" class="fixed bottom-0 left-0 right-0 z-40 bg-forest-deep/94 backdrop-blur-xl border-t-[0.5px] border-white/10 rounded-t-[28px] shadow-[0_-10px_34px_rgba(0,0,0,0.32)] transition-all duration-300 ease-out translate-y-[calc(100%-112px)] sm:translate-y-[calc(100%-120px)] pb-20">
    <!-- Drag Handle -->
    <div id="sheet-handle" class="w-full py-3.5 cursor-pointer flex justify-center items-center group">
      <div class="w-9 h-1.5 bg-white/20 rounded-full group-active:bg-white/40 transition-colors"></div>
    </div>

    <!-- Sheet Header -->
    <div class="px-6 mb-4 text-center">
      <h3 class="text-[15px] font-semibold text-cream-warm font-header">Plant Groups</h3>
      <p class="text-[11px] text-sage-light/65 mt-0.5">Choose a group or search the campus collection</p>
    </div>

    <!-- Integrated Search (Visible only when expanded) -->
    <div class="px-5 mb-5">
        <div class="relative group">
            <div class="absolute inset-y-0 left-4 flex items-center pointer-events-none text-sage-light/70 group-focus-within:text-cream-warm transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
            </div>
            <input 
                type="search" 
                id="map-search-input" 
                placeholder="Search plants" 
                class="w-full bg-white/5 border border-white/10 rounded-[14px] py-3.5 pl-12 pr-10 text-cream-warm text-sm placeholder:text-sage-light/40 focus:outline-none focus:ring-2 focus:ring-cream-warm/15 transition-all"
            />
            <button id="clear-map-search" aria-label="Clear map search" class="absolute inset-y-0 right-3 hidden items-center text-sage-light hover:text-cream-warm">
                <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="m15 9-6 6"/><path d="m9 9 6 6"/></svg>
            </button>
        </div>
    </div>

    <!-- Search Results (Overlay) -->
    <div id="map-search-results" class="hidden px-4 mb-4">
        <div id="map-results-list" class="space-y-1 max-h-[40vh] overflow-y-auto no-scrollbar"></div>
    </div>

    <!-- Group List -->
    <div class="px-4 overflow-y-auto max-h-[50vh] no-scrollbar pb-10" id="map-group-list">
      <div class="grid grid-cols-1 gap-1.5">
        {groupsData.map((group, index) => (
          <button 
            class={`group-filter-btn w-full px-5 py-4 rounded-[16px] flex items-center justify-between transition-all font-header group border ${index === 0 ? 'bg-cream-warm/10 border-cream-warm/25 text-cream-warm' : 'bg-white/[0.035] border-transparent text-cream-warm/70 hover:bg-white/[0.06]'}`}
            data-group={group.id}
          >
            <div class="flex flex-col items-start">
              <span class="text-[15px] font-semibold tracking-tight">{group.name}</span>
              <span class="text-[11px] text-sage-light/55 font-medium mt-0.5">UGA campus collection</span>
            </div>
            <div class="w-8 h-8 rounded-full bg-white/5 flex items-center justify-center text-sage-light/55 group-active:text-cream-warm transition-colors">
               <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
            </div>
          </button>
        ))}
      </div>
    </div>
  </div>

  <!-- Native plant detail within the Map tab -->
  <div id="map-plant-modal" class="hidden fixed inset-0 z-[100] bg-forest-deep overflow-hidden detail-screen">
    <div class="h-full w-full flex flex-col bg-forest-deep">
      <header class="shrink-0 glass native-detail-header border-b border-white/8 px-3 flex items-center justify-between">
        <button id="close-map-modal" aria-label="Back to map" class="min-w-0 text-cream-warm flex items-center gap-0.5 font-medium nav-header py-2 pr-3 active:opacity-60 transition-opacity">
          <svg xmlns="http://www.w3.org/2000/svg" width="23" height="23" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
          <span>Map</span>
        </button>
        <h2 id="map-modal-title" class="text-[15px] font-semibold text-cream-warm/90 truncate px-2 font-header">Plant</h2>
        <div class="w-16"></div>
      </header>

      <div class="flex-1 overflow-y-auto no-scrollbar pb-28" id="map-modal-content">
        <!-- Content will be dynamically injected here -->
      </div>
    </div>
  </div>
</div>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />

<script>
  import L from 'leaflet';

  const mapElement = document.getElementById('map');
  const groupList = document.getElementById('map-group-list');
  const recenterBtn = document.getElementById('recenter-map');
  const modal = document.getElementById('map-plant-modal');
  const modalContent = document.getElementById('map-modal-content');
  const closeModal = document.getElementById('close-map-modal');
  const modalTitle = document.getElementById('map-modal-title');
  const bottomSheet = document.getElementById('bottom-sheet');
  const sheetHandle = document.getElementById('sheet-handle');

  // Search Elements
  const mapResultsList = document.getElementById('map-results-list');
  const mapSearchInput = document.getElementById('map-search-input');
  const clearMapSearch = document.getElementById('clear-map-search');
  const mapSearchResults = document.getElementById('map-search-results');
  
  if (mapElement) {
    const escapeHtml = (value) => String(value ?? '')
      .replaceAll('&', '&amp;')
      .replaceAll('<', '&lt;')
      .replaceAll('>', '&gt;')
      .replaceAll('"', '&quot;')
      .replaceAll("'", '&#039;');

    const ugaCenter = [33.948, -83.375];
    const map = L.map('map', { 
      zoomControl: false, 
      tap: true, 
      preferCanvas: true,
      maxZoom: 19
    }).setView(ugaCenter, 17);

    map.createPane('spiderPane');
    map.getPane('spiderPane').style.zIndex = '450';

    L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}', {
      attribution: 'Esri Satellite',
      maxZoom: 19
    }).addTo(map);

    L.tileLayer('https://{s}.basemaps.cartocdn.com/light_only_labels/{z}/{x}/{y}{r}.png', { 
      subdomains: 'abcd', 
      maxZoom: 19 
    }).addTo(map);

    // User Location
    let userPos = null;
    let locationMarker = null;
    let accuracyCircle = null;

    map.locate({setView: false, watch: true, enableHighAccuracy: true});
    
    const locationIcon = L.divIcon({
      className: 'user-location-marker',
      html: `<div class="w-4 h-4 bg-red-500 border-2 border-white rounded-full shadow-[0_0_15px_rgba(239,68,68,0.8)] animate-pulse"></div>`,
      iconSize: [16, 16],
      iconAnchor: [8, 8]
    });
    
    map.on('locationfound', (e) => {
      userPos = (e as any).latlng;
      const accuracy = (e as any).accuracy;

      if (!locationMarker) {
        locationMarker = L.marker(userPos, { icon: locationIcon }).addTo(map);
      } else {
        locationMarker.setLatLng(userPos);
      }

      if (!accuracyCircle) {
        accuracyCircle = L.circle(userPos, {
          radius: accuracy,
          color: '#ef4444',
          fillColor: '#ef4444',
          fillOpacity: 0.1,
          weight: 1,
          opacity: 0.3,
          interactive: false
        }).addTo(map);
      } else {
        accuracyCircle.setLatLng(userPos);
        accuracyCircle.setRadius(accuracy);
      }
    });

    recenterBtn.addEventListener('click', () => {
      if (userPos) map.flyTo(userPos, 18);
    });

    // Map Search Logic
    let allPlants = [];

    const setupSearch = (plants) => {
      allPlants = plants;
      
      mapSearchInput?.addEventListener('input', (e) => {
        const query = e.target.value.toLowerCase().trim();
        
        if (query === '') {
          mapSearchResults.classList.add('hidden');
          groupList.classList.remove('hidden');
          clearMapSearch.classList.add('hidden');
          return;
        }

        clearMapSearch.classList.remove('hidden');
        mapSearchResults.classList.remove('hidden');
        groupList.classList.add('hidden');

        const filtered = allPlants.filter(p => 
          String(p.commonName || '').toLowerCase().includes(query) || 
          String(p.scientificName || '').toLowerCase().includes(query)
        ).slice(0, 10);

        if (filtered.length === 0) {
          mapResultsList.innerHTML = `<div class="px-4 py-3 text-xs text-sage-light text-center">No matches found</div>`;
        } else {
          mapResultsList.innerHTML = filtered.map(plant => {
            const imageUrl = plant.optimizedImageUrl || plant.displayImageUrl || plant.imageUrl;
            return `
              <button class="map-search-item w-full flex items-center gap-3 px-2.5 py-2.5 hover:bg-white/5 rounded-xl transition-all text-left" data-id="${escapeHtml(plant.id)}">
                <div class="w-11 h-11 rounded-[11px] overflow-hidden shrink-0 bg-forest-deep border border-white/8">
                  ${imageUrl ? `<img src="${escapeHtml(imageUrl)}" class="w-full h-full object-cover" alt="" />` : ''}
                </div>
                <div class="min-w-0 flex-1">
                  <div class="text-[13px] font-semibold text-cream-warm tracking-tight font-header truncate">${escapeHtml(plant.commonName || plant.scientificName)}</div>
                  <div class="botanical-name text-[13px] leading-tight text-sage-light/75 truncate">${escapeHtml(plant.scientificName)}</div>
                </div>
                <svg class="text-sage-light/40 shrink-0" xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
              </button>
            `;
          }).join('');

          document.querySelectorAll('.map-search-item').forEach(btn => {
            btn.addEventListener('click', () => {
              const pid = btn.dataset.id;
              const plant = allPlants.find(p => p.id === pid);
              if (plant) {
                // Collapse search and drawer
                mapSearchInput.value = '';
                mapSearchResults.classList.add('hidden');
                groupList.classList.remove('hidden');
                clearMapSearch.classList.add('hidden');
                
                // Switch group if needed
                const groupBtns = document.querySelectorAll('.group-filter-btn');
                groupBtns.forEach(gb => {
                  const b = gb as any;
                  if (b.dataset.group === plant.groupId) b.click();
                });

                // Fly to plant
                setTimeout(() => {
                  map.flyTo([plant.latitude, plant.longitude], 19, { duration: 1.5 });
                  setTimeout(() => showPlantDetail(plant), 1600);
                }, 100);
              }
            });
          });
        }
      });
    };

    clearMapSearch?.addEventListener('click', () => {
      mapSearchInput.value = '';
      mapSearchResults.classList.add('hidden');
      groupList.classList.remove('hidden');
      clearMapSearch.classList.add('hidden');
      mapSearchInput.focus();
    });

    // Marker Management
    const markersByGroup = {};
    const groupLayers = L.layerGroup().addTo(map);

    const createPlantIcon = (number) => L.divIcon({
      className: 'plant-marker',
      html: `
        <div class="flex items-center justify-center w-8 h-8 bg-[#E7E2D6] rounded-full border-2 border-[#5E6F66] shadow-2xl transition-transform active:scale-95">
          <span class="text-[#2A3A34] font-black text-[13px] tracking-tighter font-header">${number}</span>
        </div>
      `,
      iconSize: [32, 32],
      iconAnchor: [16, 16]
    });

    const createTrunkIcon = () => L.divIcon({
      className: 'trunk-marker',
      html: `<div class="w-2.5 h-2.5 bg-red-500 rounded-full border-2 border-white shadow-lg"></div>`,
      iconSize: [10, 10],
      iconAnchor: [5, 5]
    });

    const getDistance = (lat1, lon1, lat2, lon2) => {
      const R = 6371e3;
      const φ1 = lat1 * Math.PI/180;
      const φ2 = lat2 * Math.PI/180;
      const Δφ = (lat2-lat1) * Math.PI/180;
      const Δλ = (lon2-lon1) * Math.PI/180;
      const a = Math.sin(Δφ/2) * Math.sin(Δφ/2) +
                Math.cos(φ1) * Math.cos(φ2) *
                Math.sin(Δλ/2) * Math.sin(Δλ/2);
      const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));
      return R * c;
    };

    const getBearing = (lat1, lon1, lat2, lon2) => {
      const y = Math.sin((lon2 - lon1) * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180);
      const x = Math.cos(lat1 * Math.PI / 180) * Math.sin(lat2 * Math.PI / 180) -
                Math.sin(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) * Math.cos((lon2 - lon1) * Math.PI / 180);
      return (Math.atan2(y, x) * 180 / Math.PI + 360) % 360;
    };

    const updateMapMarkers = (selectedGroupId) => {
        groupLayers.clearLayers();
        const plants = markersByGroup[selectedGroupId] || [];
        if (plants.length === 0) return;

        const proximityGroups: any[] = [];
        const threshold = 5.0; 

        plants.forEach((plant: any) => {
            let foundGroup = proximityGroups.find(g => getDistance(plant.latitude, plant.longitude, g.lat, g.lng) < threshold);
            if (!foundGroup) {
                foundGroup = { lat: plant.latitude, lng: plant.longitude, members: [] };
                proximityGroups.push(foundGroup);
            }
            foundGroup.members.push(plant);
        });

        const activeMarkers: any[] = [];

        proximityGroups.forEach(group => {
            const count = group.members.length;
            const centerLat = group.members.reduce((sum, p) => sum + p.latitude, 0) / count;
            const centerLng = group.members.reduce((sum, p) => sum + p.longitude, 0) / count;

            if (count > 1) {
                L.marker([centerLat, centerLng], { 
                    icon: createTrunkIcon(), 
                    pane: 'spiderPane',
                    interactive: false 
                }).addTo(groupLayers);

                const obstacles = (plants as any).filter(p => !group.members.includes(p) && getDistance(centerLat, centerLng, p.latitude, p.longitude) < 15);
                const obstacleBearings = obstacles.map(p => getBearing(centerLat, centerLng, p.latitude, p.longitude));

                let bestStartAngle = 0;
                let maxMinDistance = 0;
                
                for (let a = 0; a < 360; a += 15) {
                    let minDistanceToObstacle = 360;
                    group.members.forEach((_, i) => {
                        let angle = (a + (i / count) * 360) % 360;
                        if (count === 2 && i === 1) angle = (a + 135) % 360;
                        
                        obstacleBearings.forEach(ob => {
                            const diff = Math.abs(angle - ob);
                            const dist = Math.min(diff, 360 - diff);
                            if (dist < minDistanceToObstacle) minDistanceToObstacle = dist;
                        });
                    });
                    if (minDistanceToObstacle > maxMinDistance) {
                        maxMinDistance = minDistanceToObstacle;
                        bestStartAngle = a;
                    }
                }

                const radius = 0.00018; 
                group.members.forEach((plant, i) => {
                    let angle = (bestStartAngle + (i / count) * 360) % 360;
                    if (count === 2 && i === 1) angle = (bestStartAngle + 135) % 360;
                    
                    const rad = angle * Math.PI / 180;
                    const newLat = centerLat + (radius * Math.cos(rad));
                    const newLng = centerLng + (radius * Math.sin(rad));

                    L.polyline([[centerLat, centerLng], [newLat, newLng]], {
                        color: 'white',
                        weight: 4.5,
                        opacity: 0.5,
                        pane: 'spiderPane'
                    }).addTo(groupLayers);

                    L.polyline([[centerLat, centerLng], [newLat, newLng]], {
                        color: '#ef4444',
                        weight: 2.5,
                        opacity: 0.8,
                        dashArray: '4, 4',
                        pane: 'spiderPane'
                    }).addTo(groupLayers);

                    const marker = L.marker([newLat, newLng], { 
                        icon: createPlantIcon(plant.number),
                        zIndexOffset: 1000 
                    });
                    marker.on('click', () => showPlantDetail(plant));
                    marker.addTo(groupLayers);
                    activeMarkers.push(marker);
                });
            } else {
                const plant = group.members[0];
                const marker = L.marker([plant.latitude, plant.longitude], { icon: createPlantIcon(plant.number) });
                marker.on('click', () => showPlantDetail(plant));
                marker.addTo(groupLayers);
                activeMarkers.push(marker);
            }
        });

        if (activeMarkers.length > 0) {
            const bounds = L.featureGroup(activeMarkers).getBounds();
            map.fitBounds(bounds, { padding: [50, 50] });
        }
    };

    // Map plant detail
    const closePlantDetail = () => {
      modal?.classList.add('hidden');
      document.body.classList.remove('overflow-hidden');
    };

    const showPlantDetail = (plant) => {
      const displayUrl = plant.optimizedImageUrl || plant.displayImageUrl || plant.imageUrl;
      const lightboxUrl = plant.displayImageUrl || plant.imageUrl || displayUrl;
      const imageCredit = plant.imageCredit ? `Image: ${plant.imageCredit}${plant.imageLicense ? ` · ${plant.imageLicense}` : ''}` : '';
      const cues = [
        plant.leafArrangement ? `${plant.leafArrangement} leaves` : '',
        plant.leafShape || '',
        plant.leafMargin ? `${plant.leafMargin} margin` : ''
      ].filter(Boolean);
      const leafRows = [
        { label: 'Arrangement', val: plant.leafArrangement },
        { label: 'Shape', val: plant.leafShape },
        { label: 'Margin', val: plant.leafMargin },
        { label: 'Base', val: plant.leafBase },
        { label: 'Apex', val: plant.leafApex }
      ].filter(row => row.val);
      const section = (title, value) => value ? `
        <section class="plant-info-section">
          <h3>${escapeHtml(title)}</h3>
          <p>${escapeHtml(value)}</p>
        </section>
      ` : '';

      if (modalTitle) modalTitle.textContent = plant.commonName || plant.scientificName || 'Plant';

      modalContent.innerHTML = `
        <article class="plant-detail-card overflow-hidden">
          ${displayUrl ? `
            <button id="map-detail-image" class="w-full aspect-[4/3] max-h-[430px] bg-black/15 overflow-hidden relative cursor-zoom-in" data-image-url="${escapeHtml(lightboxUrl)}" aria-label="Open larger plant image">
              <img src="${escapeHtml(displayUrl)}" class="absolute inset-0 w-full h-full object-cover scale-110 blur-2xl opacity-25" aria-hidden="true" alt="" />
              <div class="absolute inset-0 bg-forest-deep/25"></div>
              <img src="${escapeHtml(displayUrl)}" class="relative z-10 w-full h-full object-contain" loading="eager" alt="${escapeHtml(plant.commonName || plant.scientificName)}" />
              ${imageCredit ? `<span class="absolute z-20 bottom-3 right-3 max-w-[85%] rounded-lg bg-forest-deep/80 backdrop-blur-md px-2.5 py-1 text-[9px] font-medium text-cream-warm/70">${escapeHtml(imageCredit)}</span>` : ''}
            </button>
          ` : `
            <div class="w-full aspect-[4/3] max-h-[430px] flex items-center justify-center bg-white/[0.025] text-sage-light/20">
              <svg xmlns="http://www.w3.org/2000/svg" width="68" height="68" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
            </div>
          `}

          <div class="px-5 pt-6 pb-8">
            <div class="min-w-0">
              <h2 class="text-[30px] font-bold text-cream-warm leading-[1.02] tracking-tight">${escapeHtml(plant.commonName || plant.scientificName)}</h2>
              <div class="botanical-name text-[22px] text-sage-light mt-2 leading-tight">${escapeHtml(plant.scientificName)}</div>
              ${plant.family ? `<div class="text-[12px] font-medium text-sage-light/65 mt-2">${escapeHtml(plant.family)}</div>` : ''}
            </div>

            ${cues.length ? `
              <div class="mt-5 flex flex-wrap gap-2">
                ${cues.map(cue => `<span class="inline-flex items-center rounded-full bg-forest-deep/40 border border-white/8 px-3 py-1.5 text-[11px] font-medium text-cream-warm/80 nav-header">${escapeHtml(cue)}</span>`).join('')}
              </div>
            ` : ''}

            ${leafRows.length ? `
              <section class="plant-info-section mt-7">
                <h3>Leaf</h3>
                <div class="native-data-list">
                  ${leafRows.map(row => `<div><span>${escapeHtml(row.label)}</span><strong>${escapeHtml(row.val)}</strong></div>`).join('')}
                </div>
              </section>
            ` : ''}

            ${section('Bark', plant.bark)}
            ${section('Flower', plant.flower)}
            ${section('Fruit', plant.fruit)}
          </div>
        </article>
      `;

      modalContent.querySelector('#map-detail-image')?.addEventListener('click', (event) => {
        const imageUrl = (event.currentTarget as HTMLElement).dataset.imageUrl;
        if (imageUrl) window.openLightbox?.(imageUrl);
      });

      modalContent.scrollTo({ top: 0, behavior: 'instant' });
      modal?.classList.remove('hidden');
      document.body.classList.add('overflow-hidden');
    };

    closeModal?.addEventListener('click', closePlantDetail);
    window.closeMapPlantDetail = closePlantDetail;

    window.focusPlant = (lat, lng, id) => {
      fetch('/api/plants.json')
        .then(res => res.json())
        .then(plants => {
          const plant = plants.find(p => p.id === id);
          if (plant) {
            const btns = document.querySelectorAll('.group-filter-btn');
            btns.forEach(btn => {
                const b = btn as any;
                if (b.dataset.group === plant.groupId) {
                    b.click();
                }
            });
            setTimeout(() => {
                map.flyTo([lat, lng], 19, { duration: 1.5 });
                setTimeout(() => showPlantDetail(plant), 1600);
            }, 300);
          }
        });
    };

    fetch('/api/plants.json')
      .then(res => res.json())
      .then(plants => {
        setupSearch(plants);
        const sortedByGroup = {};
        plants.forEach(p => {
          if (!sortedByGroup[p.groupId]) sortedByGroup[p.groupId] = [];
          sortedByGroup[p.groupId].push(p);
        });
        
        Object.keys(sortedByGroup).forEach(gid => {
          sortedByGroup[gid].sort((a, b) => {
            const orderDiff = (a.sortOrder ?? 9999) - (b.sortOrder ?? 9999);
            if (orderDiff !== 0) return orderDiff;
            return a.scientificName.localeCompare(b.scientificName);
          });
        });

        plants.forEach(plant => {
          if (plant.latitude && plant.longitude) {
            const groupList = sortedByGroup[plant.groupId] || [];
            const plantNumber = plant.sortOrder ?? (groupList.findIndex(p => p.id === plant.id) + 1);
            
            if (!markersByGroup[plant.groupId]) markersByGroup[plant.groupId] = [];
            markersByGroup[plant.groupId].push({ ...plant, number: plantNumber });
          }
        });

        const firstBtn = document.querySelector('.group-filter-btn');
        if (firstBtn) {
            updateMapMarkers((firstBtn as any).dataset.group);
        }
      });

    groupList.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('button');
      if (!btn) return;

      const selectedGroup = btn.dataset.group;

      document.querySelectorAll('.group-filter-btn').forEach(b => {
        b.classList.remove('bg-cream-warm/10', 'border-cream-warm/25', 'text-cream-warm');
        b.classList.add('bg-white/[0.035]', 'border-transparent', 'text-cream-warm/70');
      });
      btn.classList.add('bg-cream-warm/10', 'border-cream-warm/25', 'text-cream-warm');
      btn.classList.remove('bg-white/[0.035]', 'border-transparent', 'text-cream-warm/70');

      if (selectedGroup) {
          updateMapMarkers(selectedGroup);
          // Auto-collapse after selection on mobile
          if (window.innerWidth < 640) {
              isExpanded = false;
              bottomSheet.classList.remove('translate-y-0');
              bottomSheet.classList.add('translate-y-[calc(100%-112px)]');
          }
      }
    });

    // Sheet Interaction Logic
    let isExpanded = false;
    sheetHandle.addEventListener('click', () => {
        isExpanded = !isExpanded;
        if (isExpanded) {
            bottomSheet.classList.remove('translate-y-[calc(100%-112px)]', 'sm:translate-y-[calc(100%-120px)]');
            bottomSheet.classList.add('translate-y-0');
        } else {
            bottomSheet.classList.add('translate-y-[calc(100%-112px)]', 'sm:translate-y-[calc(100%-120px)]');
            bottomSheet.classList.remove('translate-y-0');
            // Reset search when collapsing
            mapSearchInput.value = '';
            mapSearchResults.classList.add('hidden');
            groupList.classList.remove('hidden');
            clearMapSearch.classList.add('hidden');
        }
    });
  }
</script>

<style is:global>
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
</style>
