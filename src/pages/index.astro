---
import Layout from '../layouts/Layout.astro';
import CampusMap from '../components/CampusMap.astro';
import { db, Groups, Plants } from 'astro:db';
import { Image, getImage } from 'astro:assets';
import { applyF26Curriculum, sortGroupsByNumber, sortPlantsByGroupOrder } from '../utils/plantSort';
import { resolvePlantImages } from '../utils/plantImages';

const groupsData = sortGroupsByNumber(await db.select().from(Groups));
const plantsData = resolvePlantImages(sortPlantsByGroupOrder(applyF26Curriculum(await db.select().from(Plants))));

const groups = await Promise.all(groupsData.map(async (group) => {
  const plantsInGroup = sortPlantsByGroupOrder(plantsData
    .filter(p => p.groupId === group.id));
  
	const plantsWithOptimizedImages = await Promise.all(plantsInGroup.map(async (plant) => {
		const sourceImageUrl = plant.displayImageUrl || plant.imageUrl;
		let optimizedImageUrl = sourceImageUrl;
		let thumbnailImageUrl = sourceImageUrl;
		if (sourceImageUrl) {
			try {
        const optimized = await getImage({ 
          src: sourceImageUrl, 
          width: 1200, 
          format: 'webp',
          quality: 85
        });
        optimizedImageUrl = optimized.src;
			} catch (e) {
				console.error(`Failed to optimize image for ${plant.scientificName}:`, e);
			}
			try {
				const thumbnail = await getImage({
					src: sourceImageUrl,
					width: 240,
					format: 'webp',
					quality: 72
				});
				thumbnailImageUrl = thumbnail.src;
			} catch (e) {
				console.error(`Failed to create thumbnail for ${plant.scientificName}:`, e);
			}
		}
		return { ...plant, optimizedImageUrl, thumbnailImageUrl };
	}));

	const heroPlant = plantsWithOptimizedImages.find(p => p.displayImageUrl || p.imageUrl);
	const heroImage = heroPlant ? (heroPlant.displayImageUrl || heroPlant.imageUrl) : null;
	const heroThumbnail = heroPlant?.thumbnailImageUrl || heroImage;
	  
	return { ...group, plants: plantsWithOptimizedImages, heroImage, heroThumbnail };
}));
---

<Layout>
	<main class="pb-32 bg-forest-deep min-h-screen">
		<!-- Native-style top navigation -->
		<nav class="sticky top-0 z-40 glass native-topbar border-b border-white/5 px-5 transition-all" id="top-nav">
			<div class="flex justify-between items-center gap-4 mb-1">
				<span class="text-[12px] font-semibold text-sage-light/90 nav-header">UGA Woody ID · Fall 2026</span>
				<a href="/admin" aria-label="Open admin" class="w-9 h-9 rounded-full flex items-center justify-center text-sage-light/70 hover:text-cream-warm hover:bg-white/5 active:scale-95 transition-all nav-header">
					<svg xmlns="http://www.w3.org/2000/svg" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="1"/><circle cx="19" cy="12" r="1"/><circle cx="5" cy="12" r="1"/></svg>
				</a>
			</div>
			<h1 class="large-title transition-all duration-200" id="nav-title">Library</h1>
		</nav>

		<!-- Library View -->
		<div id="lists-view" class="mt-6 px-4 max-w-7xl mx-auto">
			<!-- Search + field ID tools -->
			<div class="mb-7 max-w-3xl mx-auto">
				<div class="flex items-center gap-3">
					<div class="relative group flex-1 min-w-0">
						<div class="absolute inset-y-0 left-4 flex items-center pointer-events-none text-sage-light/70 group-focus-within:text-cream-warm transition-colors">
							<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
						</div>
						<input type="search" id="plant-search" placeholder={`Search ${plantsData.length} species`} class="native-search w-full py-3.5 pl-12 pr-11 text-cream-warm placeholder:text-sage-light/70 focus:outline-none font-medium" />
						<button id="clear-search" aria-label="Clear search" class="absolute inset-y-0 right-1 hidden w-11 items-center justify-center text-sage-light hover:text-cream-warm">
							<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="m15 9-6 6"/><path d="m9 9 6 6"/></svg>
						</button>
					</div>
					<button id="toggle-filters" aria-label="Filter species" class="relative native-icon-button w-12 h-12 shrink-0 flex items-center justify-center text-cream-warm active:scale-95 transition-all">
						<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6h16"/><path d="M7 12h10"/><path d="M10 18h4"/></svg>
						<span id="active-filter-count" class="hidden absolute -top-1 -right-1 min-w-5 h-5 px-1 rounded-full bg-cream-warm text-forest-deep text-[10px] font-bold items-center justify-center nav-header">0</span>
					</button>
				</div>
				<p id="filter-results-summary" class="mt-2 px-1 text-[12px] text-sage-light/90 font-medium" aria-live="polite">Showing all species</p>
			</div>

			<!-- Native bottom-sheet filters -->
			<div id="filter-backdrop" class="hidden fixed inset-0 z-[84] bg-black/50 backdrop-blur-[2px]"></div>
			<div id="filter-controls" class="hidden fixed inset-x-0 bottom-0 z-[85] filter-sheet mx-auto max-w-xl max-h-[85dvh] overflow-y-auto px-5 pt-3 pb-safe" role="dialog" aria-modal="true" aria-hidden="true" aria-labelledby="filter-title">
				<div class="w-10 h-1 rounded-full bg-white/20 mx-auto mb-4"></div>
				<div class="flex items-center justify-between mb-6">
					<div>
						<p class="text-[12px] font-semibold text-sage-light/75 nav-header">Identify by traits</p>
						<h2 id="filter-title" class="text-2xl font-bold text-cream-warm tracking-tight">Filters</h2>
					</div>
					<button id="close-filters" type="button" class="text-sm font-semibold text-cream-warm px-3 py-2 rounded-xl bg-white/5 active:scale-95 transition-all">Done</button>
				</div>
				<div class="space-y-6 pb-5">
					<div>
						<label for="family-filter" class="block text-[12px] font-semibold text-sage-light/80 mb-2 nav-header">Family</label>
						<select id="family-filter" class="w-full native-control px-4 py-3.5 text-cream-warm font-medium focus:outline-none">
							<option value="">All families</option>
						</select>
					</div>
					<div class="space-y-4">
						<div>
							<div class="text-[12px] font-semibold text-sage-light mb-2 nav-header">Leaf arrangement</div>
							<div class="flex flex-wrap gap-2">
								{['Alternate', 'Opposite', 'Whorled'].map(trait => (
									<button type="button" class="trait-filter-chip native-chip min-h-11 px-3.5 py-2 text-[13px] font-semibold text-cream-warm/90 nav-header transition-all" data-category="arrangement" data-trait={trait.toLowerCase()} aria-pressed="false">{trait}</button>
								))}
							</div>
						</div>
						<div>
							<div class="text-[12px] font-semibold text-sage-light mb-2 nav-header">Leaf margin</div>
							<div class="flex flex-wrap gap-2">
								{['Entire', 'Serrate', 'Lobed'].map(trait => (
									<button type="button" class="trait-filter-chip native-chip min-h-11 px-3.5 py-2 text-[13px] font-semibold text-cream-warm/90 nav-header transition-all" data-category="margin" data-trait={trait.toLowerCase()} aria-pressed="false">{trait}</button>
								))}
							</div>
						</div>
						<div>
							<div class="text-[12px] font-semibold text-sage-light mb-2 nav-header">Leaf structure</div>
							<button type="button" class="trait-filter-chip native-chip min-h-11 px-3.5 py-2 text-[13px] font-semibold text-cream-warm/90 nav-header transition-all" data-category="structure" data-trait="compound" aria-pressed="false">Compound</button>
						</div>
					</div>
					<div class="flex items-center justify-between pt-4 border-t border-white/8">
						<button id="reset-filters" type="button" class="text-sm font-semibold text-sage-light hover:text-cream-warm transition-colors">Clear filters</button>
						<button id="apply-filters" type="button" class="bg-cream-warm text-forest-deep px-5 py-3 rounded-xl text-sm font-bold active:scale-95 transition-all">Show results</button>
					</div>
				</div>
			</div>

			<div id="groups-container" class="grid grid-cols-2 md:grid-cols-2 lg:grid-cols-3 gap-3 md:gap-5">
				{groups.map((group, index) => (
					<button 
						class="group-widget w-full relative h-44 md:h-60 rounded-[1.25rem] overflow-hidden active:scale-[0.985] transition-transform duration-150 border border-white/10 bg-forest-deep group/card"
						data-group-index={index}
						data-group-id={group.id}
					>
						<!-- Hero Background Image -->
						{group.heroImage ? (
							<Image 
								src={group.heroImage} 
								width={720} 
								height={480} 
								format="webp"
								quality={80}
								class="absolute inset-0 w-full h-full object-cover transition-transform duration-300 ease-out group-hover/card:scale-[1.03]" 
								alt={group.name} 
								loading={index < 2 ? 'eager' : 'lazy'}
							/>
						) : (
							<div class="absolute inset-0 bg-sage-muted" />
						)}
						
						<!-- Gradient Overlay -->
						<div class="absolute inset-0 bg-gradient-to-t from-forest-deep/95 via-forest-deep/25 to-transparent" />
						
						<!-- Content -->
						<div class="absolute bottom-0 left-0 right-0 p-4 md:p-6 text-left">
							<div class="flex items-end justify-between">
								<div>
									<h2 class="text-xl md:text-2xl font-bold text-cream-warm tracking-tight leading-tight mb-2 font-header drop-shadow-lg">{group.name}</h2>
									<div class="flex items-center gap-2">
										<span class="text-cream-warm/75 text-[11px] font-medium nav-header">
											{group.plants.length} species
										</span>
									</div>
								</div>
								<div class="w-8 h-8 rounded-full bg-black/20 backdrop-blur-md flex items-center justify-center text-cream-warm/80 transition-colors duration-150">
									<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
								</div>
							</div>
						</div>
					</button>
				))}
			</div>
			
			<div id="search-results" class="hidden grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 mb-8">
				<div id="search-results-list" class="contents"></div>
				<div id="no-results" class="hidden py-20 text-center">
					<div class="w-16 h-16 bg-white/5 rounded-full flex items-center justify-center mx-auto mb-4 text-sage-light">
						<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
					</div>
					<h3 class="text-lg font-bold text-cream-warm uppercase tracking-tight font-header">No Plants Found</h3>
					<p class="text-sm text-sage-light mt-1">Try another search or clear a filter.</p>
				</div>
			</div>
			
			<!-- Branding/Footer Info -->
			<div class="mt-12 px-2 text-center pb-10">
				<p class="text-[12px] text-sage-light/80 font-medium leading-relaxed nav-header">
					University of Georgia<br/>Woody Ornamentals Lab
				</p>
			</div>
		</div>

		<!-- Detail View -->
		<div id="group-detail" class="hidden fixed inset-0 z-50 bg-forest-deep overflow-y-auto no-scrollbar detail-screen">
			<header class="sticky top-0 z-10 glass native-detail-header border-b border-white/8 px-3 flex items-center justify-between">
				<button id="close-detail" class="min-w-0 text-cream-warm flex items-center gap-0.5 font-medium nav-header py-2 pr-3 active:opacity-60 transition-opacity">
					<svg xmlns="http://www.w3.org/2000/svg" width="23" height="23" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
					<span id="detail-back-label" class="truncate max-w-24">Library</span>
				</button>
				<h2 id="header-detail-title" class="text-[15px] font-semibold text-cream-warm/90 truncate px-2 font-header"></h2>
				<div class="w-20"></div>
			</header>
			<div id="detail-heading" class="px-5 mt-6 mb-5 max-w-3xl mx-auto">
				<h2 id="detail-title" class="large-title"></h2>
				<p id="detail-subtitle" class="text-sm text-sage-light/90 mt-1"></p>
			</div>
			<div id="detail-list" class="px-4 pb-28 max-w-3xl mx-auto"></div>
		</div>

			<div id="study-view" class="hidden mt-5 px-4 pb-32 overflow-y-auto no-scrollbar h-full max-w-5xl mx-auto">
			<p class="mb-5 text-center text-[14px] font-medium text-sage-light/90">Choose a group, direction, and practice mode.</p>

			<button id="study-all-groups" class="w-full mb-4 native-list-card p-4 flex items-center justify-between text-left active:scale-[0.99] transition-transform duration-150">
				<div class="flex items-center gap-4 min-w-0">
					<div class="w-14 h-14 rounded-2xl bg-cream-warm/10 border border-cream-warm/15 flex items-center justify-center text-cream-warm shrink-0">
						<svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="25" height="25" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z"/><path d="M8 7h6"/><path d="M8 11h8"/></svg>
					</div>
					<div class="min-w-0">
						<h2 class="text-[18px] font-semibold text-cream-warm tracking-tight">Cumulative review</h2>
						<div class="flex flex-wrap items-center gap-2 mt-1">
							<p class="text-[12px] font-medium text-sage-light/90">All {plantsData.length} species</p>
							<span class="missed-count-badge hidden bg-red-400/15 border border-red-400/30 text-red-100 text-[10px] font-bold px-2 py-1 rounded-full" data-group-id="all">0 missed</span>
						</div>
					</div>
				</div>
				<svg aria-hidden="true" class="text-cream-warm/80 shrink-0" xmlns="http://www.w3.org/2000/svg" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
			</button>

			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
				{groups.map((group, index) => (
					<button 
						class="study-group-card group w-full native-list-card p-4 flex items-center justify-between active:scale-[0.99] transition-transform duration-150"
						data-group-index={index}
						data-group-id={group.id}
					>
						<div class="flex items-center gap-5 text-left">
							<div class="w-14 h-14 rounded-2xl overflow-hidden border border-white/10 shrink-0">
								{group.heroImage ? (
									<img src={group.heroThumbnail || group.heroImage} class="w-full h-full object-cover" loading="lazy" alt="" />
								) : (
									<div class="w-full h-full bg-forest-deep" />
								)}
							</div>
							<div>
								<h3 class="text-[17px] font-semibold text-cream-warm font-header tracking-tight">{group.name}</h3>
								<div class="flex flex-wrap items-center gap-2 mt-1">
									<p class="text-[12px] font-medium text-sage-light/90 nav-header">{group.plants.length} species</p>
									<span class="missed-count-badge hidden bg-red-400/15 border border-red-400/30 text-red-100 text-[10px] font-bold px-2 py-1 rounded-full" data-group-id={group.id}>0 missed</span>
								</div>
							</div>
						</div>
						<div class="w-10 h-10 rounded-full bg-cream-warm/5 flex items-center justify-center text-cream-warm border border-white/5">
							<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
						</div>
					</button>
				))}
			</div>
		</div>

		<!-- Study Mode Selector -->
		<div id="study-mode-modal" class="hidden fixed inset-0 z-[80] bg-black/55 backdrop-blur-[2px] flex items-end sm:items-center justify-center sm:p-6" role="dialog" aria-modal="true" aria-labelledby="study-mode-title" aria-describedby="study-mode-description">
			<div class="w-full max-w-md max-h-[90dvh] overflow-y-auto filter-sheet sm:rounded-[1.75rem] px-5 pt-4 pb-6 pb-safe">
				<div class="w-10 h-1 rounded-full bg-white/20 mx-auto mb-5 sm:hidden"></div>
				<p id="mode-selector-group-name" class="text-[12px] font-semibold text-sage-light mb-1 text-center nav-header">Collection name</p>
				<h2 id="study-mode-title" class="text-2xl font-bold text-cream-warm text-center font-header">Choose practice mode</h2>
				<p id="study-mode-description" class="text-[13px] text-sage-light/90 text-center mt-2 mb-5">Set the answer direction before you begin.</p>

				<div class="mb-5">
					<p class="text-[12px] font-semibold text-sage-light mb-2">Answer direction</p>
					<div id="study-direction-selector" class="grid grid-cols-2 gap-2" role="group" aria-label="Answer direction">
						<button type="button" data-mode="sci-to-com" aria-pressed="true" class="min-h-14 rounded-xl border border-cream-warm bg-cream-warm px-3 py-2 text-left text-forest-deep transition-colors">
							<strong class="block text-[13px] leading-tight">Scientific → common</strong>
							<span class="block mt-1 text-[11px] leading-tight opacity-75">See scientific first</span>
						</button>
						<button type="button" data-mode="com-to-sci" aria-pressed="false" class="min-h-14 rounded-xl border border-white/15 bg-forest-deep/60 px-3 py-2 text-left text-cream-warm/80 transition-colors">
							<strong class="block text-[13px] leading-tight">Common → scientific</strong>
							<span class="block mt-1 text-[11px] leading-tight opacity-75">See common first</span>
						</button>
					</div>
				</div>
				
				<div class="space-y-3">
					<button id="select-flashcards" class="w-full bg-cream-warm text-forest-deep py-4 rounded-2xl flex items-center justify-center gap-3 active:scale-[0.98] transition-all">
						<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z"/><path d="M8 7h6"/><path d="M8 11h8"/></svg>
						<span class="text-[15px] font-semibold nav-header">Flash cards</span>
					</button>
					<button id="select-quiz" class="w-full bg-forest-deep border border-cream-warm/30 text-cream-warm py-4 rounded-2xl flex items-center justify-center gap-3 active:scale-[0.98] transition-all">
						<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m9 11 3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
						<span class="text-[15px] font-semibold nav-header">Typing quiz</span>
					</button>
					<button id="select-image-quiz" class="w-full bg-forest-deep border border-cream-warm/30 text-cream-warm py-4 rounded-2xl flex items-center justify-center gap-3 active:scale-[0.98] transition-all">
						<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
						<span class="text-[15px] font-semibold nav-header">Image quiz</span>
					</button>
					<button id="select-review-missed" class="hidden w-full bg-cream-warm/10 border border-cream-warm/20 text-cream-warm py-4 rounded-2xl flex items-center justify-center gap-3 active:scale-[0.98] transition-all">
						<span class="text-[15px] font-semibold nav-header">Review missed species</span>
						<span id="review-missed-count" class="bg-cream-warm text-forest-deep text-[11px] font-bold px-2.5 py-1 rounded-full nav-header">0</span>
					</button>
					<button id="cancel-study" class="w-full min-h-11 text-sage-light/90 text-[14px] font-semibold nav-header">Cancel</button>
				</div>
			</div>
		</div>

		<!-- Quiz View -->
		<div id="quiz-view" class="hidden fixed inset-0 z-[70] bg-forest-deep overflow-hidden flex flex-col animate-in fade-in duration-300">
			<header class="glass border-b-[0.5px] border-white/10 px-4 py-4 flex items-center justify-between shrink-0">
				<button id="close-quiz" class="text-cream-warm flex items-center gap-1 font-semibold nav-header">
					<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
					<span>Back</span>
				</button>
				<div id="quiz-direction-label" class="min-h-9 px-3 py-2 rounded-full bg-white/5 border border-white/10 text-[11px] font-semibold text-cream-warm/90 text-center">Scientific → common</div>
				<div class="w-12"></div>
			</header>

			<div class="flex-grow flex flex-col items-center justify-start pt-12 px-6 relative overflow-y-auto no-scrollbar">
				<!-- Quiz Progress -->
				<div class="mb-8 text-center w-full">
					<span id="quiz-progress" class="text-[11px] font-bold text-sage-light uppercase tracking-[0.2em] nav-header">Question 1 of 12</span>
					<div class="w-full max-w-xs h-1 bg-white/5 rounded-full mt-3 mx-auto overflow-hidden">
						<div id="quiz-progress-bar" class="h-full bg-cream-warm transition-all duration-500 w-0"></div>
					</div>
				</div>

				<!-- Question Card -->
				<div id="quiz-card" class="w-full max-w-md bg-sage-muted rounded-3xl border border-white/10 p-6 sm:p-10 text-center shadow-2xl mb-10 transition-all duration-300">
					<h3 id="quiz-prompt-label" class="text-[10px] font-black text-sage-light uppercase tracking-[0.3em] mb-8 nav-header">What is the common name?</h3>
					<div id="quiz-image-wrap" class="hidden mb-8 rounded-2xl overflow-hidden border border-white/10 bg-forest-deep h-64 shadow-inner">
						<img id="quiz-image" src="" alt="Plant quiz image" class="w-full h-full object-cover" />
					</div>
					<div id="quiz-question-text" class="text-3xl font-bold text-cream-warm leading-tight font-header tracking-tight mb-4">Quercus alba</div>
					<p id="quiz-helper-text" class="text-[13px] text-sage-light/80 font-medium">Typos, punctuation, and genus abbreviations are accepted.</p>
					
					<!-- Answer Input -->
					<div class="relative mt-8">
						<input 
							type="text" 
							id="quiz-answer-input" 
							placeholder="Type answer..." 
							class="w-full bg-forest-deep/50 border-2 border-white/10 rounded-2xl px-6 py-5 text-cream-warm text-lg font-bold placeholder:text-white/10 focus:outline-none focus:border-cream-warm/50 transition-all text-center"
							autocomplete="off"
							autocorrect="off"
							autocapitalize="off"
							spellcheck="false"
						/>
						<div id="quiz-feedback-icon" class="absolute right-4 top-1/2 -translate-y-1/2 hidden scale-0 transition-transform">
							<!-- Icons injected -->
						</div>
					</div>

					<p id="quiz-match-note" class="hidden mt-4 text-[12px] font-bold text-cream-warm/70"></p>

					<!-- Correction Reveal -->
					<div id="quiz-correction" class="mt-8 hidden animate-in slide-in-from-bottom duration-300">
						<p class="text-[10px] font-bold text-red-400 uppercase tracking-widest nav-header mb-3">Correct Answer:</p>
						<p id="quiz-correct-reveal" class="text-2xl font-bold text-cream-warm font-header tracking-tight">White oak</p>
					</div>
				</div>

				<!-- Quiz Button -->
				<button id="quiz-submit-btn" class="w-full max-w-xs bg-cream-warm text-forest-deep py-5 rounded-2xl text-[12px] font-black uppercase tracking-[0.2em] active:scale-95 transition-all shadow-xl nav-header mb-12">
					Submit Answer
				</button>
			</div>
		</div>

		<!-- Quiz Results View -->
		<div id="quiz-results-view" class="hidden fixed inset-0 z-[90] bg-forest-deep overflow-hidden flex flex-col items-center justify-center px-8 animate-in fade-in duration-500">
			<div class="w-full max-w-md text-center">
				<h3 class="text-[10px] font-black text-sage-light uppercase tracking-[0.3em] mb-6 nav-header">Quiz Completed</h3>
				<div class="relative w-48 h-48 mx-auto mb-8">
					<svg class="w-full h-full transform -rotate-90">
						<circle cx="96" cy="96" r="88" stroke="currentColor" stroke-width="12" fill="transparent" class="text-white/5" />
						<circle id="results-ring" cx="96" cy="96" r="88" stroke="currentColor" stroke-width="12" fill="transparent" stroke-dasharray="552.92" stroke-dashoffset="552.92" class="text-cream-warm transition-all duration-[1500ms] ease-out" />
					</svg>
					<div class="absolute inset-0 flex flex-col items-center justify-center">
						<span id="results-percent" class="text-5xl font-black text-cream-warm font-header tracking-tighter">0%</span>
					</div>
				</div>
				<h2 id="results-grade" class="text-3xl font-black text-cream-warm mb-4 font-header uppercase tracking-tight">Excellent!</h2>
				<p id="results-score-text" class="text-sage-light font-medium uppercase tracking-[0.2em] text-[11px] mb-12 nav-header">You got 10 of 12 correct</p>

				<div class="space-y-4">
					<button id="retry-missed-btn" class="hidden w-full bg-cream-warm text-forest-deep py-5 rounded-2xl flex items-center justify-center gap-4 active:scale-95 transition-all">
						<span class="text-[12px] font-black uppercase tracking-[0.2em] nav-header">Study Incorrect Answers</span>
					</button>
					<button id="quiz-restart-all" class="w-full bg-white/5 border border-white/10 text-cream-warm py-5 rounded-2xl flex items-center justify-center gap-4 active:scale-95 transition-all">
						<span class="text-[12px] font-black uppercase tracking-[0.2em] nav-header">Restart Full Quiz</span>
					</button>
					<button id="results-exit" class="w-full py-4 text-sage-light/90 text-[12px] font-semibold nav-header">Back to Study</button>
				</div>
			</div>
		</div>

		<!-- Flash Cards View -->
		<div id="flashcard-view" class="hidden fixed inset-0 z-[70] bg-forest-deep overflow-hidden flex flex-col animate-in fade-in duration-300">
			<header class="glass border-b-[0.5px] border-white/10 px-4 py-4 flex items-center justify-between shrink-0">
				<button id="close-flashcards" class="text-cream-warm flex items-center gap-1 font-semibold nav-header">
					<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
					<span>Back</span>
				</button>
				<div class="flex bg-white/5 p-1 rounded-full border border-white/10" id="study-mode-toggle" role="group" aria-label="Flash card direction">
					<button class="px-3 py-2 rounded-full text-[11px] font-semibold transition-all bg-cream-warm text-forest-deep" data-mode="sci-to-com" aria-pressed="true">Sci → common</button>
					<button class="px-3 py-2 rounded-full text-[11px] font-semibold transition-all text-cream-warm/70" data-mode="com-to-sci" aria-pressed="false">Common → sci</button>
				</div>
				<div class="w-12"></div> <!-- Spacer -->
			</header>

			<div class="flex-grow flex flex-col items-center justify-center px-6 relative">
				<!-- Progress -->
				<div class="absolute top-8 left-0 right-0 text-center">
					<span id="flashcard-progress" class="text-[11px] font-bold text-sage-light uppercase tracking-[0.2em] nav-header">1 of 12</span>
				</div>

				<!-- The Card Container (3D Context) -->
				<button type="button" id="flashcard-deck" aria-label="Flip flash card" aria-pressed="false" class="block w-full max-w-md aspect-[3/4] perspective-1000 cursor-pointer">
					<div id="flashcard-inner" class="relative w-full h-full transition-transform duration-500 transform-style-3d shadow-2xl">
						<!-- Front Side -->
						<div id="card-front" class="absolute inset-0 backface-hidden bg-sage-muted rounded-3xl border border-white/10 flex flex-col items-center justify-center p-8 text-center shadow-inner">
							<h3 class="text-[10px] font-black text-sage-light uppercase tracking-[0.3em] mb-8 nav-header">Study Mode</h3>
							<div id="card-front-text" class="text-3xl font-bold text-cream-warm leading-tight font-header tracking-tight">Scientific name</div>
							<div class="mt-12 text-cream-warm/30 animate-pulse">
								<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
							</div>
						</div>
						<!-- Back Side -->
						<div id="card-back" class="absolute inset-0 backface-hidden bg-forest-deep rounded-3xl border border-cream-warm/20 flex flex-col items-center justify-center p-8 text-center rotate-y-180 overflow-hidden">
							<div id="card-back-image-container" class="absolute inset-0 opacity-20 grayscale pointer-events-none">
								<img id="card-back-image" src="" class="w-full h-full object-cover" />
							</div>
							<div class="relative z-10">
								<h3 class="text-[10px] font-black text-sage-light uppercase tracking-[0.3em] mb-8 nav-header">Correct Answer</h3>
								<div id="card-back-text" class="text-3xl font-bold text-cream-warm leading-tight font-header tracking-tight mb-4">Common name</div>
								<div id="card-back-family" class="text-[15px] font-medium text-sage-light italic uppercase tracking-widest nav-header opacity-70">Family Name</div>
								<div id="card-back-cues" class="mt-6 flex flex-wrap gap-2 justify-center"></div>
							</div>
						</div>
					</div>
				</button>

				<!-- Controls -->
				<div class="mt-12 flex items-center gap-8">
					<button id="prev-card" class="w-14 h-14 rounded-full bg-white/5 border border-white/10 flex items-center justify-center text-cream-warm active:scale-90 transition-all">
						<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
					</button>
					<button id="shuffle-cards" class="bg-forest-deep text-cream-warm px-8 py-4 rounded-full text-[12px] font-black uppercase tracking-[0.2em] border border-cream-warm/30 shadow-xl active:scale-95 transition-all flex items-center gap-3 nav-header">
						<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M2 18h1.4c1.3 0 2.5-.6 3.3-1.7l6.1-8.6c.7-1.1 2-1.7 3.3-1.7H22"/><path d="m18 2 4 4-4 4"/><path d="M2 6h1.9c1.5 0 2.9.9 3.6 2.2"/><path d="M22 18h-5.9c-1.3 0-2.6-.7-3.3-1.8l-.5-.8"/><path d="m18 14 4 4-4 4"/></svg>
						Shuffle
					</button>
					<button id="next-card" class="w-14 h-14 rounded-full bg-white/5 border border-white/10 flex items-center justify-center text-cream-warm active:scale-90 transition-all">
						<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
					</button>
				</div>
			</div>
		</div>

		<!-- Maps View -->
			<div id="maps-view" class="hidden fixed inset-0 z-30 bg-forest-deep">
				<div class="h-full flex flex-col pt-safe">
					<div class="flex-grow">
					<CampusMap />
				</div>
			</div>
		</div>

		<!-- Mature iOS Tab Bar -->
			<nav class="fixed bottom-0 left-0 right-0 z-[60] native-tabbar border-t border-white/10 pb-safe" aria-label="Primary navigation">
			<div class="flex h-16 max-w-lg mx-auto">
				<button 
						class="tab-btn is-active flex-1 flex flex-col items-center justify-center gap-1 transition-colors text-cream-warm" 
						data-view="lists"
						aria-current="page"
				>
					<div class="p-1.5 rounded-xl transition-colors">
						<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z"/><path d="M8 7h6"/><path d="M8 11h8"/></svg>
					</div>
					<span class="text-[11px] font-semibold nav-header">Library</span>
				</button>
				<button 
						class="tab-btn flex-1 flex flex-col items-center justify-center gap-1 transition-colors text-sage-light/85" 
					data-view="study"
				>
					<div class="p-1.5 rounded-xl transition-colors">
						<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 11 3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
					</div>
					<span class="text-[11px] font-semibold nav-header">Study</span>
				</button>
				<button 
						class="tab-btn flex-1 flex flex-col items-center justify-center gap-1 transition-colors text-sage-light/85" 
					data-view="maps"
				>
					<div class="p-1.5 rounded-xl transition-colors">
						<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
					</div>
					<span class="text-[11px] font-semibold nav-header">Map</span>
				</button>
			</div>
		</nav>
	</main>
</Layout>

<script define:vars={{ groups }}>
	const tabButtons = document.querySelectorAll('.tab-btn');
	const listsView = document.getElementById('lists-view');
	const studyView = document.getElementById('study-view');
	const mapsView = document.getElementById('maps-view');
	const groupWidgets = document.querySelectorAll('.group-widget');
	const groupDetail = document.getElementById('group-detail');
	const detailTitle = document.getElementById('detail-title');
	const headerDetailTitle = document.getElementById('header-detail-title');
	const detailList = document.getElementById('detail-list');
	const detailSubtitle = document.getElementById('detail-subtitle');
	const detailBackLabel = document.getElementById('detail-back-label');
	const closeDetail = document.getElementById('close-detail');

	// Search and filter elements
	const allPlants = groups.flatMap(g => g.plants.map(p => ({ ...p, groupName: g.name })));
	const plantSearchInput = document.getElementById('plant-search');
	const clearSearchBtn = document.getElementById('clear-search');
	const groupsContainer = document.getElementById('groups-container');
	const searchResults = document.getElementById('search-results');
	const searchResultsList = document.getElementById('search-results-list');
	const noResults = document.getElementById('no-results');
	const toggleFilters = document.getElementById('toggle-filters');
	const filterControls = document.getElementById('filter-controls');
	const filterBackdrop = document.getElementById('filter-backdrop');
	const closeFilters = document.getElementById('close-filters');
	const applyFilters = document.getElementById('apply-filters');
	const familyFilter = document.getElementById('family-filter');
	const traitFilterChips = document.querySelectorAll('.trait-filter-chip');
	const resetFiltersBtn = document.getElementById('reset-filters');
	const activeFilterCount = document.getElementById('active-filter-count');
	const filterResultsSummary = document.getElementById('filter-results-summary');

	// Flashcard elements
	const flashcardView = document.getElementById('flashcard-view');
	const closeFlashcards = document.getElementById('close-flashcards');
	const studyModeToggle = document.getElementById('study-mode-toggle');
	const flashcardProgress = document.getElementById('flashcard-progress');
	const cardFrontText = document.getElementById('card-front-text');
	const cardBackText = document.getElementById('card-back-text');
	const cardBackFamily = document.getElementById('card-back-family');
	const cardBackCues = document.getElementById('card-back-cues');
	const cardBackImage = document.getElementById('card-back-image');
	const flashcardDeck = document.getElementById('flashcard-deck');
	const flashcardInner = document.getElementById('flashcard-inner');
	const prevCardBtn = document.getElementById('prev-card');
	const nextCardBtn = document.getElementById('next-card');
	const shuffleBtn = document.getElementById('shuffle-cards');

	// Study hub elements
	const studyModeModal = document.getElementById('study-mode-modal');
	const modeSelectorGroupName = document.getElementById('mode-selector-group-name');
	const studyDirectionSelector = document.getElementById('study-direction-selector');
	const studyAllGroups = document.getElementById('study-all-groups');
	const selectFlashcards = document.getElementById('select-flashcards');
	const selectQuiz = document.getElementById('select-quiz');
	const selectImageQuiz = document.getElementById('select-image-quiz');
	const selectReviewMissed = document.getElementById('select-review-missed');
	const reviewMissedCount = document.getElementById('review-missed-count');
	const cancelStudy = document.getElementById('cancel-study');
	const studyGroupCards = document.querySelectorAll('.study-group-card');

	// Quiz elements
	const quizView = document.getElementById('quiz-view');
	const closeQuiz = document.getElementById('close-quiz');
	const quizDirectionLabel = document.getElementById('quiz-direction-label');
	const quizProgress = document.getElementById('quiz-progress');
	const quizProgressBar = document.getElementById('quiz-progress-bar');
	const quizCard = document.getElementById('quiz-card');
	const quizPromptLabel = document.getElementById('quiz-prompt-label');
	const quizImageWrap = document.getElementById('quiz-image-wrap');
	const quizImage = document.getElementById('quiz-image');
	const quizQuestionText = document.getElementById('quiz-question-text');
	const quizHelperText = document.getElementById('quiz-helper-text');
	const quizAnswerInput = document.getElementById('quiz-answer-input');
	const quizSubmitBtn = document.getElementById('quiz-submit-btn');
	const quizMatchNote = document.getElementById('quiz-match-note');
	const quizCorrection = document.getElementById('quiz-correction');
	const quizCorrectReveal = document.getElementById('quiz-correct-reveal');

	// Results elements
	const quizResultsView = document.getElementById('quiz-results-view');
	const resultsPercent = document.getElementById('results-percent');
	const resultsRing = document.getElementById('results-ring');
	const resultsGrade = document.getElementById('results-grade');
	const resultsScoreText = document.getElementById('results-score-text');
	const retryMissedBtn = document.getElementById('retry-missed-btn');
	const quizRestartAll = document.getElementById('quiz-restart-all');
	const resultsExit = document.getElementById('results-exit');

	const MISSED_KEY = 'woodyid.missed.v1';
	const activeTraits = new Set();

	let currentGroupPlants = [];
	let currentFlashcards = [];
	let currentCardIndex = 0;
	let isFlipped = false;
	let studyMode = 'sci-to-com';
	let activeStudyGroup = null;
	let quizQueue = [];
	let missedPlants = [];
	let quizScore = 0;
	let isAwaitingNext = false;
	let quizType = 'typing';
	let quizSource = 'group';
	let activeDetailGroup = null;
	let detailMode = 'group';
	let filterReturnFocus = null;
	let studyReturnFocus = null;

	const rememberActiveGroup = (groupId, source = 'app') => {
		const id = String(groupId || '');
		if (!id) return;
		localStorage.setItem('woodyid.activeGroup', id);
		window.dispatchEvent(new CustomEvent('woodyid:group-changed', { detail: { groupId: id, source } }));
	};

	const escapeHtml = (value) => String(value ?? '')
		.replace(/&/g, '&amp;')
		.replace(/</g, '&lt;')
		.replace(/>/g, '&gt;')
		.replace(/"/g, '&quot;')
		.replace(/'/g, '&#039;');

	const normalizeText = (value) => String(value ?? '')
		.normalize('NFD')
		.replace(/[\u0300-\u036f]/g, '')
		.replace(/[’‘`´]/g, "'")
		.replace(/×/g, ' x ')
		.toLowerCase()
		.replace(/[^a-z0-9]+/g, ' ')
		.replace(/\s+/g, ' ')
		.trim();

	const normalizeAnswer = (value) => String(value ?? '')
		.replace(/[’‘`´]/g, "'")
		.replace(/['’]s\b/gi, 's')
		.replace(/×/g, ' x ')
		.normalize('NFD')
		.replace(/[\u0300-\u036f]/g, '')
		.toLowerCase()
		.replace(/[^a-z0-9]+/g, ' ')
		.replace(/\s+/g, ' ')
		.trim();

	const shorten = (value, max = 70) => {
		const text = String(value ?? '');
		return text.length > max ? `${text.slice(0, max - 1)}…` : text;
	};

	const getPlantById = (id) => allPlants.find(p => String(p.id) === String(id));
	const getGroupName = (groupId) => groups.find(group => String(group.id) === String(groupId))?.name || '';
	const getCourseContext = (plant) => [
		plant.groupName || getGroupName(plant.groupId),
		plant.sortOrder ? `#${plant.sortOrder}` : ''
	].filter(Boolean).join(' · ');

	const shuffleArray = (array) => {
		const newArray = [...array];
		for (let i = newArray.length - 1; i > 0; i--) {
			const j = Math.floor(Math.random() * (i + 1));
			[newArray[i], newArray[j]] = [newArray[j], newArray[i]];
		}
		return newArray;
	};

	const getKeyCues = (plant) => {
		const cues = [];
		if (plant.leafArrangement) cues.push(`${plant.leafArrangement} leaves`);
		if (plant.leafShape) cues.push(plant.leafShape);
		if (plant.leafMargin) cues.push(`${plant.leafMargin} margin`);
		if (plant.bark) cues.push(`Bark: ${plant.bark}`);
		if (plant.fruit) cues.push(`Fruit: ${plant.fruit}`);
		if (plant.flower) cues.push(`Flower: ${plant.flower}`);
		if (plant.family) cues.push(`${plant.family} family`);
		if (plant.commonName && cues.length < 3) cues.push(`Common name: ${plant.commonName}`);
		if (plant.scientificName && cues.length < 3) cues.push(`Scientific name: ${plant.scientificName}`);
		return cues.slice(0, 3);
	};

	const renderCuePills = (plant, compact = false) => {
		const cues = getKeyCues(plant);
		return cues.map(cue => `
			<span class="inline-flex items-center rounded-full bg-forest-deep/40 border border-white/8 px-3 py-1.5 text-[11px] font-medium text-cream-warm/80 nav-header ${compact ? 'max-w-full' : ''}">
				${escapeHtml(shorten(cue, compact ? 46 : 90))}
			</span>
		`).join('');
	};

	const renderPlantListItem = (plant) => {
		const imageUrl = plant.thumbnailImageUrl || plant.optimizedImageUrl || plant.displayImageUrl || plant.imageUrl;
		const courseContext = getCourseContext(plant);
		return `
			<button class="plant-list-item native-species-row w-full text-left" data-plant-id="${escapeHtml(plant.id)}">
				<div class="w-[72px] h-[72px] rounded-[14px] overflow-hidden shrink-0 bg-sage-muted/25">
					${imageUrl ? `<img src="${escapeHtml(imageUrl)}" class="w-full h-full object-cover" loading="lazy" alt="${escapeHtml(plant.commonName || plant.scientificName)}" />` : ''}
				</div>
				<div class="min-w-0 flex-1 py-0.5">
					<h3 class="text-[17px] leading-tight font-semibold text-cream-warm truncate">${escapeHtml(plant.commonName || plant.scientificName)}</h3>
					<p class="botanical-name text-[16px] leading-tight text-sage-light mt-1 truncate">${escapeHtml(plant.scientificName)}</p>
					<p class="text-[12px] text-sage-light/90 mt-1.5 truncate">${escapeHtml([courseContext, plant.family].filter(Boolean).join(' · '))}</p>
				</div>
				<svg class="text-sage-light/45 shrink-0" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
			</button>`;
	};

	const renderPlantCard = (plant) => {
		const hasLocation = plant.latitude !== null && plant.latitude !== undefined && plant.longitude !== null && plant.longitude !== undefined;
		const imageUrl = plant.optimizedImageUrl || plant.displayImageUrl || plant.imageUrl;
		const imageCredit = plant.imageCredit ? `Image: ${plant.imageCredit}${plant.imageLicense ? ` · ${plant.imageLicense}` : ''}` : '';
		const courseContext = getCourseContext(plant);
		const leafRows = [
			{ label: 'Arrangement', val: plant.leafArrangement },
			{ label: 'Shape', val: plant.leafShape },
			{ label: 'Margin', val: plant.leafMargin },
			{ label: 'Base', val: plant.leafBase },
			{ label: 'Apex', val: plant.leafApex }
		].filter(f => f.val);
		const section = (title, value) => value ? `
			<section class="plant-info-section">
				<h3>${escapeHtml(title)}</h3>
				<p>${escapeHtml(value)}</p>
			</section>` : '';
		return `
			<article class="plant-detail-card overflow-hidden">
				${imageUrl ? `
					<button class="plant-image-button w-full aspect-[4/3] max-h-[430px] bg-forest-deep overflow-hidden relative cursor-zoom-in" data-image-url="${escapeHtml(plant.displayImageUrl || plant.imageUrl || imageUrl)}">
						<img src="${escapeHtml(imageUrl)}" class="w-full h-full object-cover" loading="eager" alt="${escapeHtml(plant.commonName || plant.scientificName)}" />
						<div class="absolute inset-0 bg-gradient-to-t from-forest-deep/35 via-transparent to-transparent"></div>
						${imageCredit ? `<span class="absolute bottom-3 right-3 max-w-[85%] rounded-lg bg-forest-deep/75 backdrop-blur-md px-2.5 py-1 text-[9px] font-medium text-cream-warm/70">${escapeHtml(imageCredit)}</span>` : ''}
					</button>` : ''}
				<div class="px-5 pt-6 pb-8">
					<div class="flex items-start justify-between gap-4">
						<div class="min-w-0">
							${courseContext ? `<div class="course-context">${escapeHtml(courseContext)}</div>` : ''}
							<h2 class="text-[30px] font-bold text-cream-warm leading-[1.02] tracking-tight">${escapeHtml(plant.commonName || plant.scientificName)}</h2>
							<div class="botanical-name text-[22px] text-sage-light mt-2 leading-tight">${escapeHtml(plant.scientificName)}</div>
						${plant.family ? `<div class="text-[12px] font-medium text-sage-light/90 mt-2">${escapeHtml(plant.family)}</div>` : ''}
						</div>
						${hasLocation ? `<button class="see-on-map-btn native-icon-button w-11 h-11 flex items-center justify-center text-cream-warm shrink-0" aria-label="View on map" data-id="${escapeHtml(plant.id)}"><svg xmlns="http://www.w3.org/2000/svg" width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg></button>` : ''}
					</div>
					<div class="mt-5 flex flex-wrap gap-2">${renderCuePills(plant)}</div>
					${leafRows.length ? `<section class="plant-info-section mt-7"><h3>Leaf</h3><div class="native-data-list">${leafRows.map(row => `<div><span>${escapeHtml(row.label)}</span><strong>${escapeHtml(row.val)}</strong></div>`).join('')}</div></section>` : ''}
					${section('Bark', plant.bark)}
					${section('Flower', plant.flower)}
					${section('Fruit', plant.fruit)}
					${hasLocation ? `<button class="see-on-map-btn mt-7 w-full bg-cream-warm text-forest-deep py-3.5 rounded-[14px] font-bold text-[15px] active:scale-[0.99] transition-transform" data-id="${escapeHtml(plant.id)}">View on Map</button>` : ''}
				</div>
			</article>`;
	};

	const bindPlantCardActions = (container) => {
		container.querySelectorAll('.plant-image-button').forEach(btn => {
			btn.addEventListener('click', () => window.openLightbox?.(btn.dataset.imageUrl));
		});
		container.querySelectorAll('.see-on-map-btn').forEach(btn => {
			btn.addEventListener('click', () => {
				const plant = getPlantById(btn.dataset.id);
				if (!plant) return;
				switchTab('maps');
				if (window.focusPlant) window.focusPlant(parseFloat(plant.latitude), parseFloat(plant.longitude), plant.id);
			});
		});
	};

	const renderPlantDetail = (plant, sourceGroup = null) => {
		rememberActiveGroup(plant.groupId, 'library');
		detailMode = 'plant';
		activeDetailGroup = sourceGroup;
		detailTitle.textContent = '';
		detailSubtitle.textContent = '';
		document.getElementById('detail-heading').classList.add('hidden');
		headerDetailTitle.textContent = plant.commonName || plant.scientificName;
		detailBackLabel.textContent = sourceGroup?.name || 'Library';
		detailList.className = 'px-0 pb-28 max-w-3xl mx-auto';
		detailList.innerHTML = renderPlantCard(plant);
		bindPlantCardActions(detailList);
		groupDetail.classList.remove('hidden');
		document.body.classList.add('overflow-hidden');
		groupDetail.scrollTo({ top: 0, behavior: 'instant' });
