	const renderGroupDetail = (group) => {
		rememberActiveGroup(group.id, 'library');
		detailMode = 'group';
		activeDetailGroup = group;
		document.getElementById('detail-heading').classList.remove('hidden');
		detailTitle.textContent = group.name;
		detailSubtitle.textContent = `${group.plants.length} species`;
		headerDetailTitle.textContent = group.name;
		detailBackLabel.textContent = 'Library';
		detailList.className = 'px-4 pb-28 max-w-3xl mx-auto native-species-list';
		detailList.innerHTML = group.plants.map(renderPlantListItem).join('');
		detailList.querySelectorAll('.plant-list-item').forEach(btn => {
			btn.addEventListener('click', () => {
				const plant = getPlantById(btn.dataset.plantId);
				if (plant) renderPlantDetail(plant, group);
			});
		});
		groupDetail.classList.remove('hidden');
		document.body.classList.add('overflow-hidden');
		groupDetail.scrollTo({ top: 0, behavior: 'instant' });
	};

	const getMissedBank = () => {
		try {
			return JSON.parse(localStorage.getItem(MISSED_KEY) || '{}');
		} catch {
			return {};
		}
	};

	const saveMissedBank = (bank) => {
		localStorage.setItem(MISSED_KEY, JSON.stringify(bank));
		updateStudyBadges();
	};

	const addMissedPlant = (plant) => {
		const bank = getMissedBank();
		const existing = bank[plant.id] || { misses: 0 };
		bank[plant.id] = {
			id: plant.id,
			groupId: plant.groupId,
			scientificName: plant.scientificName,
			commonName: plant.commonName,
			misses: (existing.misses || 0) + 1,
			lastMissedAt: new Date().toISOString()
		};
		saveMissedBank(bank);
	};

	const removeMissedPlant = (plant) => {
		const bank = getMissedBank();
		if (bank[plant.id]) {
			delete bank[plant.id];
			saveMissedBank(bank);
		}
	};

	const getMissedPlantsForGroup = (groupId) => {
		const bank = getMissedBank();
		return allPlants
			.filter(plant => bank[plant.id] && (groupId === 'all' || String(plant.groupId) === String(groupId)))
			.sort((a, b) => {
				const aEntry = bank[a.id];
				const bEntry = bank[b.id];
				return (bEntry.misses || 0) - (aEntry.misses || 0) ||
					String(bEntry.lastMissedAt || '').localeCompare(String(aEntry.lastMissedAt || ''));
			});
	};

	const updateStudyBadges = () => {
		document.querySelectorAll('.missed-count-badge').forEach(badge => {
			const missedCount = getMissedPlantsForGroup(badge.dataset.groupId).length;
			badge.textContent = `${missedCount} missed`;
			badge.classList.toggle('hidden', missedCount === 0);
		});

		if (activeStudyGroup && selectReviewMissed && reviewMissedCount) {
			const count = getMissedPlantsForGroup(activeStudyGroup.id).length;
			reviewMissedCount.textContent = String(count);
			selectReviewMissed.classList.toggle('hidden', count === 0);
		}
	};

	const getAcceptedAnswers = (plant, mode) => {
		const answers = new Set();
		const nameVariants = (value) => {
			const raw = String(value || '').trim();
			const parenthetical = [...raw.matchAll(/\(([^)]+)\)/g)].map(match => match[1].trim()).filter(Boolean);
			const preferred = raw.replace(/\s*\([^)]+\)\s*/g, ' ').replace(/\s+/g, ' ').trim();
			return [...new Set([raw, preferred, ...parenthetical].filter(Boolean))];
		};
		if (mode === 'sci-to-com') {
			nameVariants(plant.commonName).forEach(name => {
				answers.add(normalizeAnswer(name));
				if (/[’'‘]s\b/i.test(name)) answers.add(normalizeAnswer(name.replace(/[’'‘]s\b/gi, '')));
				if (name.includes('-')) answers.add(normalizeAnswer(name.replace(/-/g, ' ')));
			});
		} else {
			nameVariants(plant.scientificName).forEach(name => {
				const scientific = normalizeAnswer(name);
				answers.add(scientific);
				answers.add(scientific.replace(/\s+x\s+/g, ' '));
				const parts = scientific.split(' ');
				if (parts.length >= 2) {
					answers.add(`${parts[0][0]} ${parts.slice(1).join(' ')}`);
					answers.add(normalizeAnswer(`${parts[0][0]}. ${parts.slice(1).join(' ')}`));
				}
			});
		}
		return [...answers].filter(Boolean);
	};

	const levenshtein = (a, b) => {
		const dp = Array.from({ length: a.length + 1 }, () => Array(b.length + 1).fill(0));
		for (let i = 0; i <= a.length; i++) dp[i][0] = i;
		for (let j = 0; j <= b.length; j++) dp[0][j] = j;
		for (let i = 1; i <= a.length; i++) {
			for (let j = 1; j <= b.length; j++) {
				const cost = a[i - 1] === b[j - 1] ? 0 : 1;
				dp[i][j] = Math.min(dp[i - 1][j] + 1, dp[i][j - 1] + 1, dp[i - 1][j - 1] + cost);
			}
		}
		return dp[a.length][b.length];
	};

	const checkAnswerMatch = (userAnswer, plant) => {
		const normalizedUser = normalizeAnswer(userAnswer);
		if (!normalizedUser) return { correct: false, note: '' };
		const accepted = getAcceptedAnswers(plant, studyMode);
		if (accepted.includes(normalizedUser)) return { correct: true, note: 'Exact match accepted.' };

		for (const answer of accepted) {
			const lengthDelta = Math.abs(answer.length - normalizedUser.length);
			if (lengthDelta > 3) continue;
			const distance = levenshtein(normalizedUser, answer);
			const limit = answer.length > 18 ? 3 : answer.length > 8 ? 2 : 1;
			if (distance > 0 && distance <= limit) {
				return { correct: true, note: 'Accepted — close spelling.' };
			}
		}

		return { correct: false, note: '' };
	};

	const populateFamilyFilter = () => {
		if (!familyFilter) return;
		const families = [...new Set(allPlants.map(p => p.family).filter(Boolean))].sort((a, b) => a.localeCompare(b));
		familyFilter.insertAdjacentHTML('beforeend', families.map(family => `<option value="${escapeHtml(family)}">${escapeHtml(family)}</option>`).join(''));
	};

	const plantMatchesFilters = (plant) => {
		const query = normalizeText(plantSearchInput?.value || '');
		const family = familyFilter?.value || '';
		const searchableText = normalizeText([
			plant.commonName,
			plant.scientificName,
			plant.family,
			plant.leafArrangement,
			plant.leafMargin,
			plant.leafShape,
			plant.bark,
			plant.flower,
			plant.fruit
		].join(' '));

		if (query && !searchableText.includes(query)) return false;
		if (family && plant.family !== family) return false;

		const arrangement = normalizeText(plant.leafArrangement);
		const margin = normalizeText(plant.leafMargin);
		const shape = normalizeText(plant.leafShape);
		const traitMatchers = {
			alternate: () => /\b(?:alternate|alt opp)\b/.test(arrangement),
			opposite: () => /\b(?:opposite|alt opp)\b/.test(arrangement),
			whorled: () => /\bwhorled\b/.test(arrangement),
			entire: () => /\bentire\b/.test(margin),
			serrate: () => /\bserrat(?:e|ed|ulate)\b/.test(margin),
			lobed: () => /\blob(?:ed|es)\b/.test(margin),
			compound: () => /\bcompound\b/.test(shape)
		};
		for (const trait of activeTraits) {
			if (!traitMatchers[trait]?.()) return false;
		}

		return true;
	};

	const updateFilterUI = (resultCount = allPlants.length) => {
		const count = activeTraits.size + (familyFilter?.value ? 1 : 0);
		activeFilterCount.textContent = String(count);
		activeFilterCount.classList.toggle('hidden', count === 0);
		activeFilterCount.classList.toggle('flex', count > 0);
		filterResultsSummary.textContent = count > 0 || plantSearchInput?.value.trim()
			? `${resultCount} matching species`
			: 'Showing all species';
		if (applyFilters) applyFilters.textContent = `Show ${resultCount} ${resultCount === 1 ? 'plant' : 'plants'}`;

		traitFilterChips.forEach(chip => {
			const active = activeTraits.has(chip.dataset.trait);
			chip.setAttribute('aria-pressed', String(active));
			chip.classList.toggle('bg-cream-warm', active);
			chip.classList.toggle('text-forest-deep', active);
			chip.classList.toggle('border-cream-warm', active);
			chip.classList.toggle('bg-forest-deep/50', !active);
			chip.classList.toggle('text-cream-warm/70', !active);
		});
	};

	const renderSearchResults = () => {
		const query = plantSearchInput?.value.trim() || '';
		const hasFilters = query || activeTraits.size > 0 || familyFilter?.value;

		if (!hasFilters) {
			groupsContainer.classList.remove('hidden');
			searchResults.classList.add('hidden');
			clearSearchBtn.classList.add('hidden');
			clearSearchBtn.classList.remove('flex');
			updateFilterUI(allPlants.length);
			return;
		}

		clearSearchBtn.classList.toggle('hidden', !query);
		clearSearchBtn.classList.toggle('flex', Boolean(query));
		groupsContainer.classList.add('hidden');
		searchResults.classList.remove('hidden');

		const filtered = allPlants.filter(plantMatchesFilters);
		updateFilterUI(filtered.length);

		if (filtered.length === 0) {
			searchResultsList.innerHTML = '';
			noResults.classList.remove('hidden');
			return;
		}

		noResults.classList.add('hidden');
		searchResultsList.innerHTML = filtered.map(plant => {
			const imageUrl = plant.thumbnailImageUrl || plant.optimizedImageUrl || plant.displayImageUrl || plant.imageUrl;
			const courseContext = getCourseContext(plant);
			return `
				<button class="search-result-item w-full flex items-center gap-4 p-3 native-list-card active:scale-[0.99] transition-transform text-left" data-plant-id="${escapeHtml(plant.id)}">
					<div class="w-16 h-16 rounded-xl overflow-hidden border border-white/10 shrink-0 bg-forest-deep">
						${imageUrl ? `<img src="${escapeHtml(imageUrl)}" class="w-full h-full object-cover" loading="lazy" alt="${escapeHtml(plant.commonName || plant.scientificName)}" />` : ''}
					</div>
					<div class="min-w-0 flex-1">
						<h4 class="text-[16px] font-semibold text-cream-warm tracking-tight truncate">${escapeHtml(plant.commonName || plant.scientificName)}</h4>
						<p class="botanical-name text-[15px] text-sage-light truncate mt-0.5">${escapeHtml(plant.scientificName)}</p>
						<p class="text-[12px] text-sage-light/90 truncate mt-1">${escapeHtml(courseContext)}</p>
						<div class="mt-2 flex flex-wrap gap-1.5">${renderCuePills(plant, true)}</div>
					</div>
					<div class="ml-auto text-cream-warm/20 pr-2">
						<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
					</div>
				</button>
			`;
		}).join('');

		document.querySelectorAll('.search-result-item').forEach(btn => {
			btn.addEventListener('click', () => {
				const plant = getPlantById(btn.dataset.plantId);
				if (plant) renderPlantDetail(plant);
			});
		});
	};

	const updateCard = () => {
		if (currentFlashcards.length === 0) return;
		const plant = currentFlashcards[currentCardIndex];
		isFlipped = false;
		flashcardInner.classList.remove('rotate-y-180');
		flashcardDeck.setAttribute('aria-pressed', 'false');

		if (studyMode === 'sci-to-com') {
			cardFrontText.textContent = plant.scientificName;
			cardBackText.textContent = plant.commonName;
		} else {
			cardFrontText.textContent = plant.commonName;
			cardBackText.textContent = plant.scientificName;
		}

		cardBackFamily.textContent = plant.family || '';
		cardBackImage.src = plant.optimizedImageUrl || plant.displayImageUrl || plant.imageUrl || '';
		cardBackCues.innerHTML = renderCuePills(plant, true);
		flashcardProgress.textContent = `${currentCardIndex + 1} of ${currentFlashcards.length}`;
	};

	const syncModeToggle = () => {
		[studyModeToggle, studyDirectionSelector].forEach(toggle => {
			toggle.querySelectorAll('button').forEach(b => {
				const isActive = b.dataset.mode === studyMode;
				b.setAttribute('aria-pressed', String(isActive));
				b.classList.remove('bg-cream-warm', 'bg-forest-deep/60', 'text-forest-deep', 'text-cream-warm/70', 'text-cream-warm/80', 'border-cream-warm', 'border-white/15');
				if (isActive) {
					b.classList.add('bg-cream-warm', 'text-forest-deep', 'border-cream-warm');
				} else {
					b.classList.add('bg-forest-deep/60', 'text-cream-warm/70', 'border-white/15');
				}
			});
		});

		quizDirectionLabel.textContent = quizType === 'image'
			? `Answer: ${studyMode === 'sci-to-com' ? 'common name' : 'scientific name'}`
			: (studyMode === 'sci-to-com' ? 'Scientific → common' : 'Common → scientific');
	};

	const openStudyMode = (group, trigger) => {
		activeStudyGroup = group;
		studyReturnFocus = trigger || document.activeElement;
		modeSelectorGroupName.textContent = group.name;
		updateStudyBadges();
		syncModeToggle();
		studyModeModal.classList.remove('hidden');
		document.body.classList.add('overflow-hidden');
		requestAnimationFrame(() => studyDirectionSelector.querySelector(`[data-mode="${studyMode}"]`)?.focus());
	};

	const closeStudyMode = (restoreFocus = true) => {
		studyModeModal.classList.add('hidden');
		document.body.classList.remove('overflow-hidden');
		if (restoreFocus) (studyReturnFocus as HTMLElement)?.focus?.();
	};

	const startQuiz = (plants, options = {}) => {
		quizType = options.type || 'typing';
		quizSource = options.source || 'group';
		const imagePlants = plants.filter(p => p.optimizedImageUrl || p.displayImageUrl || p.imageUrl);
		const usablePlants = quizType === 'image' && imagePlants.length > 0 ? imagePlants : plants;

		quizQueue = shuffleArray(usablePlants);
		missedPlants = [];
		currentCardIndex = 0;
		quizScore = 0;
		isAwaitingNext = false;
		quizResultsView.classList.add('hidden');
		quizView.classList.remove('hidden');
		closeStudyMode(false);
		syncModeToggle();
		updateQuizQuestion();
	};

	const updateQuizQuestion = () => {
		const plant = quizQueue[currentCardIndex];
		if (!plant) return;

		isAwaitingNext = false;
		quizAnswerInput.value = '';
		quizAnswerInput.disabled = false;
		quizAnswerInput.classList.remove('border-green-500', 'border-red-500');
		quizCard.classList.remove('shake');
		quizCorrection.classList.add('hidden');
		quizMatchNote.classList.add('hidden');
		quizMatchNote.textContent = '';
		quizSubmitBtn.textContent = 'Submit Answer';

		const expectedLabel = studyMode === 'sci-to-com' ? 'common name' : 'scientific name';
		quizPromptLabel.textContent = `What is the ${expectedLabel}?`;
		quizAnswerInput.placeholder = `Type ${expectedLabel}...`;

		if (quizType === 'image') {
			const imageUrl = plant.optimizedImageUrl || plant.displayImageUrl || plant.imageUrl;
			quizImage.src = imageUrl || '';
			quizImageWrap.classList.toggle('hidden', !imageUrl);
			quizQuestionText.textContent = 'Identify this plant';
			quizHelperText.textContent = `Answer with the ${expectedLabel}. Typos and punctuation are accepted.`;
		} else {
			quizImageWrap.classList.add('hidden');
			quizQuestionText.textContent = studyMode === 'sci-to-com' ? plant.scientificName : plant.commonName;
			quizHelperText.textContent = 'Typos, punctuation, and genus abbreviations are accepted.';
		}

		const progress = ((currentCardIndex) / quizQueue.length) * 100;
		quizProgressBar.style.width = `${progress}%`;
		quizProgress.textContent = `Question ${currentCardIndex + 1} of ${quizQueue.length}`;

		setTimeout(() => quizAnswerInput.focus(), 250);
	};

	const checkAnswer = () => {
		if (isAwaitingNext) {
			currentCardIndex++;
			if (currentCardIndex >= quizQueue.length) {
				showResults();
			} else {
				updateQuizQuestion();
			}
			return;
		}

		const plant = quizQueue[currentCardIndex];
		const correctAns = studyMode === 'sci-to-com' ? plant.commonName : plant.scientificName;
		const match = checkAnswerMatch(quizAnswerInput.value, plant);

		if (!quizAnswerInput.value.trim()) {
			quizCard.classList.add('shake');
			setTimeout(() => quizCard.classList.remove('shake'), 500);
			return;
		}

		quizAnswerInput.disabled = true;

		if (match.correct) {
			quizScore++;
			quizAnswerInput.classList.add('border-green-500');
			quizSubmitBtn.textContent = 'Correct! Next →';
			quizMatchNote.textContent = match.note;
			quizMatchNote.classList.remove('hidden');
			if (quizSource === 'missed-bank') removeMissedPlant(plant);
		} else {
			missedPlants.push(plant);
			addMissedPlant(plant);
			quizAnswerInput.classList.add('border-red-500');
			quizCard.classList.add('shake');
			quizCorrectReveal.textContent = correctAns;
			quizCorrection.classList.remove('hidden');
			quizSubmitBtn.textContent = 'Got it, Next →';
		}

		isAwaitingNext = true;
	};

	const showResults = () => {
		quizProgressBar.style.width = '100%';
		const percent = Math.round((quizScore / quizQueue.length) * 100);
		resultsPercent.textContent = `${percent}%`;
		resultsScoreText.textContent = missedPlants.length > 0
			? `You got ${quizScore} of ${quizQueue.length} correct · ${missedPlants.length} saved for review`
			: `You got ${quizScore} of ${quizQueue.length} correct`;

		const offset = 552.92 - (552.92 * percent / 100);
		resultsRing.style.strokeDashoffset = offset.toString();

		if (percent === 100) resultsGrade.textContent = 'Mastery!';
		else if (percent >= 80) resultsGrade.textContent = 'Excellent!';
		else if (percent >= 50) resultsGrade.textContent = 'Good Start!';
		else resultsGrade.textContent = 'Keep Studying!';

		retryMissedBtn.classList.toggle('hidden', missedPlants.length === 0);
		quizResultsView.classList.remove('hidden');
		quizView.classList.add('hidden');
		updateStudyBadges();
	};

	const switchTab = (view) => {
		// Root tabs always return to the root of that section.
		// This prevents a Library or Map plant detail from floating above another tab.
		groupDetail.classList.add('hidden');
		activeDetailGroup = null;
		detailMode = 'group';
		window.closeMapPlantDetail?.();
		document.body.classList.remove('overflow-hidden');

			tabButtons.forEach(btn => {
				if (btn.dataset.view === view) {
					btn.classList.add('text-cream-warm', 'is-active');
					btn.classList.remove('text-sage-light/85');
					btn.setAttribute('aria-current', 'page');
				} else {
					btn.classList.remove('text-cream-warm', 'is-active');
					btn.classList.add('text-sage-light/85');
					btn.removeAttribute('aria-current');
			}
		});

		[listsView, studyView, mapsView].forEach(v => v.classList.add('hidden'));
		document.getElementById('top-nav').classList.remove('hidden');

		if (view === 'lists') {
			listsView.classList.remove('hidden');
			document.getElementById('nav-title').textContent = 'Library';
		} else if (view === 'study') {
			studyView.classList.remove('hidden');
			document.getElementById('nav-title').textContent = 'Study';
			updateStudyBadges();
			} else {
				mapsView.classList.remove('hidden');
				document.getElementById('top-nav').classList.add('hidden');
				groupDetail.classList.add('hidden');
				window.dispatchEvent(new CustomEvent('woodyid:map-open'));
				window.requestAnimationFrame(() => window.dispatchEvent(new Event('resize')));
			}
	};

	// Search/filter handlers
	populateFamilyFilter();
	updateFilterUI();
	plantSearchInput?.addEventListener('input', renderSearchResults);
	familyFilter?.addEventListener('change', renderSearchResults);

	const setFilterSheet = (open) => {
		if (open) filterReturnFocus = document.activeElement;
		filterControls?.classList.toggle('hidden', !open);
		filterBackdrop?.classList.toggle('hidden', !open);
		filterControls?.setAttribute('aria-hidden', String(!open));
		document.body.classList.toggle('overflow-hidden', open);
		if (open) requestAnimationFrame(() => closeFilters?.focus());
		else (filterReturnFocus as HTMLElement)?.focus?.();
	};
	toggleFilters?.addEventListener('click', () => setFilterSheet(true));
	closeFilters?.addEventListener('click', () => setFilterSheet(false));
	applyFilters?.addEventListener('click', () => setFilterSheet(false));
	filterBackdrop?.addEventListener('click', () => setFilterSheet(false));

	traitFilterChips.forEach(chip => {
		chip.addEventListener('click', () => {
			const trait = chip.dataset.trait;
			const category = chip.dataset.category;
			const wasActive = activeTraits.has(trait);
			traitFilterChips.forEach(other => {
				if (other.dataset.category === category) activeTraits.delete(other.dataset.trait);
			});
			if (!wasActive) activeTraits.add(trait);
			renderSearchResults();
		});
	});

	resetFiltersBtn?.addEventListener('click', () => {
		activeTraits.clear();
		if (familyFilter) familyFilter.value = '';
		renderSearchResults();
	});

	clearSearchBtn?.addEventListener('click', () => {
		plantSearchInput.value = '';
		renderSearchResults();
		plantSearchInput.focus();
	});

	// Study hub handlers
	studyGroupCards.forEach(card => {
		card.addEventListener('click', () => {
			const gid = card.dataset.groupId;
			const group = groups.find(g => String(g.id) === String(gid));
			if (!group) return;
			rememberActiveGroup(gid, 'study');
			openStudyMode(group, card);
		});
	});

	studyAllGroups.addEventListener('click', () => {
		openStudyMode({ id: 'all', name: 'Cumulative review', plants: allPlants }, studyAllGroups);
	});

	cancelStudy.addEventListener('click', () => closeStudyMode());
	studyModeModal.addEventListener('click', (event) => {
		if (event.target === studyModeModal) closeStudyMode();
	});
	studyDirectionSelector.addEventListener('click', (event) => {
		const btn = event.target.closest('button');
		if (!btn) return;
		studyMode = btn.dataset.mode;
		syncModeToggle();
	});

	selectFlashcards.addEventListener('click', () => {
		currentGroupPlants = [...activeStudyGroup.plants];
		currentFlashcards = [...currentGroupPlants];
		currentCardIndex = 0;
		flashcardView.classList.remove('hidden');
		closeStudyMode(false);
		syncModeToggle();
		updateCard();
	});

	selectQuiz.addEventListener('click', () => startQuiz(activeStudyGroup.plants, { type: 'typing', source: 'group' }));
	selectImageQuiz.addEventListener('click', () => startQuiz(activeStudyGroup.plants, { type: 'image', source: 'group' }));
	selectReviewMissed.addEventListener('click', () => {
		const missed = getMissedPlantsForGroup(activeStudyGroup.id);
		if (missed.length > 0) startQuiz(missed, { type: 'typing', source: 'missed-bank' });
	});

	quizSubmitBtn.addEventListener('click', checkAnswer);
	quizAnswerInput.addEventListener('keypress', (e) => {
		if (e.key === 'Enter') checkAnswer();
	});

	retryMissedBtn.addEventListener('click', () => {
		const currentMissed = [...missedPlants];
		quizResultsView.classList.add('hidden');
		startQuiz(currentMissed, { type: 'typing', source: 'session-missed' });
	});

	quizRestartAll.addEventListener('click', () => {
		quizResultsView.classList.add('hidden');
		startQuiz(activeStudyGroup.plants, { type: quizType, source: 'group' });
	});

	resultsExit.addEventListener('click', () => {
		quizResultsView.classList.add('hidden');
		updateStudyBadges();
	});

	closeFlashcards.addEventListener('click', () => flashcardView.classList.add('hidden'));
	closeQuiz.addEventListener('click', () => quizView.classList.add('hidden'));

	studyModeToggle.addEventListener('click', (e) => {
		const btn = e.target.closest('button');
		if (!btn) return;
		studyMode = btn.dataset.mode;
		syncModeToggle();
		updateCard();
	});

	flashcardDeck.addEventListener('click', () => {
		isFlipped = !isFlipped;
		flashcardInner.classList.toggle('rotate-y-180', isFlipped);
		flashcardDeck.setAttribute('aria-pressed', String(isFlipped));
	});

	prevCardBtn.addEventListener('click', (e) => {
		e.stopPropagation();
		currentCardIndex = (currentCardIndex - 1 + currentFlashcards.length) % currentFlashcards.length;
		updateCard();
	});

	nextCardBtn.addEventListener('click', (e) => {
		e.stopPropagation();
		currentCardIndex = (currentCardIndex + 1) % currentFlashcards.length;
		updateCard();
	});

	shuffleBtn.addEventListener('click', (e) => {
		e.stopPropagation();
		currentFlashcards = shuffleArray(currentGroupPlants);
		currentCardIndex = 0;
		updateCard();
	});

	tabButtons.forEach(btn => btn.addEventListener('click', () => switchTab(btn.dataset.view)));

	groupWidgets.forEach(widget => {
		widget.addEventListener('click', () => {
			const group = groups.find(g => String(g.id) === String(widget.dataset.groupId));
			if (group) renderGroupDetail(group);
		});
	});

	closeDetail.addEventListener('click', () => {
		if (detailMode === 'plant' && activeDetailGroup) {
			renderGroupDetail(activeDetailGroup);
			return;
		}
		groupDetail.classList.add('hidden');
		document.body.classList.remove('overflow-hidden');
		activeDetailGroup = null;
	});

	document.addEventListener('keydown', (event) => {
		if (event.key !== 'Escape') return;
		if (!studyModeModal.classList.contains('hidden')) {
			closeStudyMode();
			return;
		}
		if (!filterControls?.classList.contains('hidden')) setFilterSheet(false);
	});

	// Compact the large title as the library scrolls.
	window.addEventListener('scroll', () => {
		const nav = document.getElementById('top-nav');
		const title = document.getElementById('nav-title');
		const compact = window.scrollY > 36;
		nav?.classList.toggle('is-compact', compact);
		if (title) title.style.fontSize = compact ? '21px' : '34px';
	}, { passive: true });

	updateStudyBadges();
</script>
