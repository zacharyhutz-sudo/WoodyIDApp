---
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="apple-mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
		<meta name="theme-color" content="#2A3A34" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>Woody ID</title>
		
		<style is:global>
			:root {
				/* Earth & Forest Palette */
				--forest-deep: #2A3A34;
				--sage-muted: #5E6F66;
				--sage-light: #AAB8B0;
				--earth-brown: #7A6A55;
				--cream-warm: #E7E2D6;
				
				--slate-950: #020617;
			}
			
			body {
				font-family: 'Outfit', sans-serif;
				background-color: var(--forest-deep);
				color: var(--cream-warm);
				-webkit-tap-highlight-color: transparent;
				-webkit-font-smoothing: antialiased;
				overflow-x: hidden;
			}

			/* Interface typography */
			h1, h2, h3, .nav-header, .font-header { font-family: 'Outfit', sans-serif; }
			.botanical-name { font-family: 'EB Garamond', serif; font-style: italic; }

			/* iOS Style Large Title */
			.large-title {
				font-family: 'Outfit', sans-serif;
				font-size: 34px;
				font-weight: 700;
				letter-spacing: -1.1px;
				line-height: 1.05;
				color: var(--cream-warm);
			}

			.glass {
				background-color: rgba(42, 58, 52, 0.85);
				backdrop-filter: blur(25px);
				-webkit-backdrop-filter: blur(25px);
			}


			/* Native shell + safe areas */
			.pt-safe { padding-top: env(safe-area-inset-top); }
			.pb-safe { padding-bottom: env(safe-area-inset-bottom); }
			.native-topbar {
				padding-top: calc(env(safe-area-inset-top) + 10px);
				padding-bottom: 11px;
			}
			.native-topbar.is-compact { padding-bottom: 8px; }
			.native-detail-header {
				padding-top: calc(env(safe-area-inset-top) + 8px);
				padding-bottom: 8px;
			}
			.native-tabbar {
				background: rgba(34, 48, 43, 0.93);
				backdrop-filter: blur(24px) saturate(140%);
				-webkit-backdrop-filter: blur(24px) saturate(140%);
			}
			.native-search, .native-control, .native-icon-button, .native-list-card {
				background: rgba(94, 111, 102, 0.18);
				border: 1px solid rgba(255,255,255,0.075);
			}
			.native-search, .native-control { border-radius: 14px; }
			.native-icon-button { border-radius: 14px; }
			.native-list-card { border-radius: 18px; }
			.native-chip {
				border-radius: 999px;
				background: rgba(255,255,255,0.045);
				border: 1px solid rgba(255,255,255,0.08);
			}
			.filter-sheet {
				background: #31433c;
				border: 1px solid rgba(255,255,255,0.08);
				border-radius: 24px 24px 0 0;
				box-shadow: 0 -18px 55px rgba(0,0,0,.28);
			}
			.native-species-list {
				background: rgba(94,111,102,.13);
				border: 1px solid rgba(255,255,255,.06);
				border-radius: 20px;
				overflow: hidden;
			}
			.native-species-row {
				display: flex;
				align-items: center;
				gap: 14px;
				padding: 11px 13px;
				border-bottom: 1px solid rgba(255,255,255,.065);
				transition: background-color .12s ease, transform .12s ease;
			}
			.native-species-row:last-child { border-bottom: 0; }
			.native-species-row:active { background: rgba(255,255,255,.045); transform: scale(.995); }
			.plant-detail-card { background: transparent; }
			.plant-info-section {
				margin-top: 26px;
				padding-top: 20px;
				border-top: 1px solid rgba(255,255,255,.08);
			}
			.plant-info-section h3 {
				font-size: 12px;
				font-weight: 700;
				letter-spacing: .02em;
				color: rgba(170,184,176,.72);
				margin-bottom: 10px;
			}
			.plant-info-section > p {
				font-size: 16px;
				line-height: 1.5;
				color: rgba(231,226,214,.92);
			}
			.native-data-list > div {
				display: flex;
				justify-content: space-between;
				gap: 20px;
				padding: 10px 0;
				border-bottom: 1px solid rgba(255,255,255,.06);
			}
			.native-data-list > div:last-child { border-bottom: 0; }
			.native-data-list span { color: rgba(170,184,176,.68); font-size: 14px; }
			.native-data-list strong { color: var(--cream-warm); font-size: 14px; font-weight: 600; text-align: right; }
			.tab-btn > div { transition: background-color .15s ease, transform .15s ease; }
			.tab-btn.is-active > div { background: rgba(231,226,214,.10); transform: translateY(-1px); }
			.detail-screen { animation: nativePush .22s cubic-bezier(.2,.8,.2,1); }
			@keyframes nativePush { from { opacity: .75; transform: translateX(18px); } to { opacity: 1; transform: translateX(0); } }
			@media (prefers-reduced-motion: reduce) {
				*, *::before, *::after { scroll-behavior: auto !important; animation-duration: .01ms !important; animation-iteration-count: 1 !important; transition-duration: .01ms !important; }
			}

			/* Hide scrollbars */
			.no-scrollbar::-webkit-scrollbar {
				display: none;
			}
			.no-scrollbar {
				-ms-overflow-style: none;
				scrollbar-width: none;
			}

			/* Animations */
			@keyframes fadeInUp {
				from {
					opacity: 0;
					transform: translateY(20px);
				}
				to {
					opacity: 1;
					transform: translateY(0);
				}
			}

			.animate-fade-up {
				animation: fadeInUp 0.28s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
				opacity: 0;
			}

			.ios-inset-list {
				background-color: var(--sage-muted);
				border-radius: 20px;
				border: 0.5px solid var(--sage-light);
				overflow: hidden;
			}

			.ios-row {
				display: flex;
				align-items: center;
				justify-content: space-between;
				padding: 16px 20px;
				border-bottom: 0.5px solid var(--sage-light);
				transition: all 0.3s;
			}
			.ios-row:last-child {
				border-bottom: none;
			}
			.ios-row:active {
				background-color: rgba(255, 255, 255, 0.1);
				transform: scale(0.98);
			}
			.perspective-1000 { perspective: 1000px; }
	.transform-style-3d { transform-style: preserve-3d; }
	.backface-hidden { backface-visibility: hidden; -webkit-backface-visibility: hidden; }
	.rotate-y-180 { transform: rotateY(180deg); }

	.shake {
		animation: shake 0.5s cubic-bezier(.36,.07,.19,.97) both;
		transform: translate3d(0, 0, 0);
	}

	@keyframes shake {
		10%, 90% { transform: translate3d(-1px, 0, 0); }
		20%, 80% { transform: translate3d(2px, 0, 0); }
		30%, 50%, 70% { transform: translate3d(-4px, 0, 0); }
		40%, 60% { transform: translate3d(4px, 0, 0); }
	}
</style>
	</head>
	<body class="min-h-screen selection:bg-cream-warm selection:text-forest-deep">
		<slot />

		<!-- Shared Image Lightbox -->
		<div id="image-lightbox" class="hidden fixed inset-0 z-[200] bg-black/95 backdrop-blur-md flex items-center justify-center p-4 animate-in fade-in duration-200">
			<button id="close-lightbox" class="absolute top-8 right-8 z-10 w-12 h-12 bg-white/10 rounded-full flex items-center justify-center text-white active:scale-90 transition-all">
				<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
			</button>
			<img id="lightbox-img" src="" class="max-w-full max-h-full object-contain rounded-lg shadow-2xl animate-in zoom-in-95 duration-300" />
		</div>

		<script>
			const lightbox = document.getElementById('image-lightbox');
			const lightboxImg = document.getElementById('lightbox-img');
			const closeLightbox = document.getElementById('close-lightbox');

			window.openLightbox = (src) => {
				if (!lightbox || !lightboxImg) return;
				lightboxImg.src = src;
				lightbox.classList.remove('hidden');
				document.body.classList.add('overflow-hidden');
			};

			closeLightbox?.addEventListener('click', () => {
				lightbox?.classList.add('hidden');
				document.body.classList.remove('overflow-hidden');
			});

			lightbox?.addEventListener('click', (e) => {
				if (e.target === lightbox) {
					lightbox.classList.add('hidden');
					document.body.classList.remove('overflow-hidden');
				}
			});
		</script>
	</body>
</html>
